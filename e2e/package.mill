package build.e2e

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*, scalalib.*, scalafmt.*
import millbuild.*

// ─────────────────────────────────────────────────────────────────────────────
// End to end: the features in `features/`, run against what `mcp.dev` released into LocalStack.
// An operator through the backoffice, guests through a browser. Not part of `mill __.test`.
// ─────────────────────────────────────────────────────────────────────────────

object `package` extends BaseModule:
  // The backoffice's: the steps call its tools with its own request types.
  def scalaVersion = "3.10.0"
  def scalafixConfig = Task(Some(build.mcp.moduleDir / ".scalafix.conf"))

  def moduleDeps = Seq(build.mcp)

  def mvnDeps = Seq(
    mvn"io.cucumber::cucumber-scala:9.2.1",
    mvn"io.cucumber:cucumber-core:8.0.4",
    mvn"com.microsoft.playwright:playwright:1.64.0"
  )

  def features: T[PathRef] = Task.Source(moduleDir / "features")

  /** The video every location of these features plays. */
  def spot: T[PathRef] = Task.Source(moduleDir / "resources" / "spot.webm")

  /** Every step of every feature, or of the feature file `only`, matched by exactly one definition,
    * without running any: Cucumber's dry run, which needs no LocalStack. Fails on an undefined or
    * ambiguous step.
    *
    * Usage: `mill e2e.check`, or `mill e2e.check --only access.feature`
    */
  def check(only: String = "") = Task.Command:
    val classpath = runClasspath().map(_.path.toString).mkString(java.io.File.pathSeparator)
    val ran = os
      .proc(
        "java",
        "-cp",
        classpath,
        "io.cucumber.core.cli.Main",
        "--glue",
        "whitelabel.captal.e2e",
        "--dry-run",
        "--plugin",
        "summary",
        (if only.isEmpty then features().path else features().path / os.RelPath(only)).toString
      )
      .call(check = false, stdout = os.Inherit, stderr = os.Inherit)
    if ran.exitCode != 0 then
      sys.error("[e2e] some steps are undefined or ambiguous")

  /** Releases this build into LocalStack as `ci.run` releases it, then runs the features against
    * it: the backoffice at its load balancer address, with the admin token the configuration
    * generated, and the portal at the distribution. Each feature deploys the locations it needs,
    * and the run destroys every `e2e-` location once the scenarios are over, any an earlier run left
    * included, unless `keep` says to leave them up to look at. Needs a LocalStack licence.
    *
    * A scenario tagged `@pending` needs something the product or this stack does not have yet; it
    * runs only when `tags` asks for it.
    *
    * Every screen is recorded, one video per page, in `out/e2e/recordings/`, by feature and
    * scenario; a scenario that runs again replaces its own folder and no other, and a failed
    * scenario's folder says so. `linger` holds each view on screen that many seconds before the
    * next, for a recording a person can follow.
    *
    * Usage: `mill e2e.cucumber`, `mill e2e.cucumber --tags @first-visit`,
    * `mill e2e.cucumber --tags @first-visit --linger 3`, or `mill e2e.cucumber --keep`
    */
  def cucumber(
      tags: String = "not @pending",
      linger: Double = 0,
      keep: mainargs.Flag = mainargs.Flag()) = Task.Command:
    val endpoint = s"http://localhost:$localStackPort"
    val target = ReleaseTarget.localStack(endpoint)
    val workDir = localStackWorkDir(endpoint, Task.env)
    build.mcp.test.tofuSources()
    println("[e2e] Releasing this build into LocalStack, as `ci.run` does...")
    build.ci.images()()
    val outputs = release(
      target,
      terraformDir(Task.env, moduleDir / os.up),
      workDir,
      build.ci.localTags(),
      build.client.bundle().path,
      build.client.releaseVersion().version,
      variables = Nil,
      awaitLocations = false
    )
    // The locations these features deploy reach the database, the relay and the UniFi stand-in.
    awaitLocalBackoffice(
      target,
      outputs("ecs_cluster_name"),
      outputs("mcp_service_name"),
      Seq("rqlite_service_name", "cdc_service_name", "unifi_fake_service_name").flatMap(
        outputs.get))
    def unifi(output: String) = outputs.getOrElse(
      output,
      sys.error(s"[e2e] no $output: the local configuration runs the UniFi stand-in only with `enable_unifi_fake`"))
    println("[e2e] Running the features...")
    val token = awsText(
      target,
      "secretsmanager",
      "get-secret-value",
      "--secret-id",
      outputs("mcp_admin_token_secret_arn"),
      "--query",
      "SecretString").getOrElse(sys.error("[e2e] could not read the admin token"))
    val classpath = runClasspath().map(_.path.toString).mkString(java.io.File.pathSeparator)
    // Outside this command's own folder, which every run empties: a run of one feature leaves the
    // other features' videos where they are.
    val recordings = mill.api.BuildCtx.workspaceRoot / "out" / "e2e" / "recordings"
    val ran = os
      .proc(
        "java",
        "-cp",
        classpath,
        "io.cucumber.core.cli.Main",
        "--glue",
        "whitelabel.captal.e2e",
        "--plugin",
        "pretty",
        Option.when(tags.nonEmpty)(Seq("--tags", tags)).toSeq.flatten,
        features().path.toString
      )
      .call(
        env = Map(
          "E2E_MCP_URL"       -> outputs("mcp_url"),
          "E2E_MCP_TOKEN"     -> token,
          "E2E_PORTAL"        -> s"https://${outputs("cloudfront_domain_name")}:$localStackPort",
          "E2E_SPOT"          -> spot().path.toString,
          "E2E_UNIFI_HOST"    -> unifi("unifi_fake_host"),
          "E2E_UNIFI_PORT"    -> unifi("unifi_fake_port"),
          "E2E_UNIFI_RECORDS" -> unifi("unifi_fake_records_url"),
          "E2E_RECORDINGS"    -> recordings.toString,
          "E2E_LINGER_SECONDS" -> linger.toString,
          "E2E_KEEP_LOCATIONS" -> keep.value.toString,
          "E2E_AWS_ENDPOINT"  -> endpoint,
          "E2E_CLUSTER"       -> outputs("ecs_cluster_name"),
          "E2E_CDC_SERVICE"   -> outputs("cdc_service_name")
        ),
        check = false,
        stdout = os.Inherit,
        stderr = os.Inherit
      )
    if os.exists(recordings) then
      // Under WSL, the same folder as Windows' Explorer reaches it.
      val windows = scala
        .util
        .Try(os.proc("wslpath", "-w", recordings).call().out.trim())
        .toOption
        .filter(_.nonEmpty)
      println(s"[e2e] Every guest's screen, by feature and scenario: $recordings")
      windows.foreach(path => println(s"[e2e]   from Windows: $path"))
    if ran.exitCode != 0 then
      sys.error("[e2e] some scenarios failed")
end `package`

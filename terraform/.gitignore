# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive files
*.tfvars
!environments/*/terraform.tfvars

# Credentials for the AWS and Tailscale providers, read from the environment so they stay out of
# state. Nothing here is derivable, so it is not committed and not templated either.
.envrc

# `backend.tf` used to be ignored here, on the grounds that it carried bucket names. It does not:
# its bucket is `""` and the value comes from `environments/<env>/backend.tfvars`, which is ignored
# by the rule above. Ignoring the block itself left a clone with no backend at all -- `tofu init`
# would quietly configure local state and write it next to the module.

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

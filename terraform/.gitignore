# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive files
*.tfvars
!environments/*/terraform.tfvars
# A state bucket's name, which is not a credential: access comes from `.envrc` below. Committed so
# `tofu init -backend-config=environments/<env>/backend.tfvars` works from a clean clone. Without
# it, `backend.tf` has `bucket = ""` and nothing in the tree says what the value is.
!environments/*/backend.tfvars

# Credentials for the AWS and Tailscale providers, read from the environment so they stay out of
# state. Nothing here is derivable, so it is not committed and not templated either.
.envrc

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

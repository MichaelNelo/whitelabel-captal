<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#6366f1">
  <title>WiFi Gratis</title>
  <!-- Same <base> as index.html, and for the same reason twice over: CloudFront rewrites /<slug>/
       to this file without touching the address bar, so the document URL is still /<slug>/ and
       every relative URL below has to resolve under it. That is also what gets this page the
       location's own stylesheet and icon without knowing which location it is standing in for. -->
  <script>
    (function () {
      var slug = location.pathname.split('/').filter(Boolean)[0];
      if (slug && slug !== 'api') {
        var b = document.createElement('base');
        b.href = '/' + slug + '/';
        document.head.appendChild(b);
      }
    })();
  </script>
  <link rel="stylesheet" href="{{CSS_PATH}}">
  <link rel="stylesheet" href="./custom-styles.css.gz" onerror="this.remove()">
  <!-- Written by the build, not by hand: the chunk names carry a content hash. Naming them here is
       what lets them be requested together with the entry instead of after it has been parsed, and
       that is one round trip off the critical path. -->
{{PRELOADS}}
</head>
<body>
  <div class="initial-loader">
    <!-- Los spans del anillo se fueron con el approach descartado; ver index.html.template. -->
    <div class="brand-ring">
      <img src="./brand-icon.svg" class="brand-icon" alt="Cargando">
    </div>
  </div>
  <div id="app"></div>
  <!-- `type="module"` now that this is a public module of the portal's linker run rather than a
       `NoModule` output of its own: a classic script cannot carry the `import`s the entry has. -->
  <script type="module" src="{{JS_PATH}}"></script>
</body>
</html>

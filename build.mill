//| mvnDeps:
//|   - com.goyeau::mill-scalafix::0.6.0
package build
import com.goyeau.mill.scalafix.ScalafixModule
import mill.*, scalalib.*, scalafmt.*, scalajslib.*

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────

/** Render index.html.template replacing {{JS_PATH}} and {{CSS_PATH}} placeholders. */
private def renderIndex(
    templatePath: os.Path,
    destPath: os.Path,
    jsPath: String,
    cssPath: String,
    preloads: String = ""): Unit =
  val template = os.read(templatePath)
  val rendered = template
    .replace("{{JS_PATH}}", jsPath)
    .replace("{{CSS_PATH}}", cssPath)
    .replace("{{PRELOADS}}", preloads)
  os.write.over(destPath, rendered)

/** A local ES import, in both forms Rollup emits: `from"./x"` for a binding and a bare
  * `import"./x"` for a side effect.
  *
  * Deliberately does not match `import("./x")`, the dynamic form, because the parenthesis is not a
  * quote. That is what keeps the route chunks out of [[preloadLinks]].
  */
private val localImport = """(?:from|import)\s*"\./([^"]+)"""".r

/** `<link rel="modulepreload">` for everything `entry` reaches through static imports.
  *
  * Rendered by the build rather than written into the template, because the chunk names carry a
  * content hash — and derived from the file rather than from a list, so it cannot drift: a preload
  * naming a hash that is no longer imported is worse than none, since the browser downloads a
  * chunk it will not use.
  *
  * What it buys, measured in a throttled browser against the built page: the dependencies stop being
  * discovered by parsing the entry and go out together with it, which removes one round trip from
  * the critical path. The app mounted 143 ms sooner at 100 ms of RTT and 315 ms sooner at 300 ms.
  *
  * `fetchpriority="low"` is there because the same measurement showed the other side of it: the
  * hint also starts 167 KB of JavaScript immediately, and the brand loader in the markup is all the
  * guest sees until the bundle mounts. Unprioritised, first paint went the wrong way by 88 ms. With
  * the attribute it comes back to where it was without the hint — 264 ms against 260 — while the
  * mount stays early, so both ends are ahead of no hint at all. "Sooner, but not ahead of what
  * renders."
  *
  * That holds at 10 Mbps and stops holding below roughly 2. On a 1.6 Mbps profile first paint is
  * 980 ms either way, and priority has nothing to do with it: it tracks `brand-icon.svg`, which
  * ends at 965 ms. The loader has no text, so the first contentful paint *is* that image — 730
  * bytes that need a round trip of their own and queue behind the bundle on a saturated pipe. It
  * was already 756 ms before any of this; the hint exposed it rather than caused it.
  *
  * Left alone deliberately. Fixing it means making the first paint depend on the document alone —
  * the icon inline as a data URI, the loader's rules in a `<style>`, and `styles.css` out of the
  * render-blocking path — which would put first paint at one round trip, better than it has ever
  * been. It is not done because the venue connections this serves are not 1.6 Mbps, and at the
  * speeds they are, there is nothing left to win.
  *
  * Transitive, because a chunk that imports another chunk would otherwise just move the late
  * discovery one level down.
  */
private def preloadLinks(dir: os.Path, entry: String): String =
  def walk(name: String, seen: Seq[String]): Seq[String] =
    if seen.contains(name) || !os.exists(dir / name) then seen
    else
      localImport
        .findAllMatchIn(os.read(dir / name))
        .map(_.group(1))
        .foldLeft(seen :+ name)((acc, next) => walk(next, acc))
  walk(entry, Seq.empty)
    .filterNot(_ == entry)
    .map(name => s"""  <link rel="modulepreload" fetchpriority="low" href="./$name">""")
    .mkString("\n")

/** Named once because two places need it: the container every suite runs against, and the image the
  * end-to-end deploy puts in its task definition — which only has to be something already pulled.
  *
  * Matched to what production runs, which is the whole point of the number. It was 8.36.2 while the
  * `terraform/docker/rqlite/Dockerfile` said `FROM rqlite/rqlite:latest` and had
  * drifted to 10.6.1 — two major versions apart, with the suite on the side that nothing deployed.
  * Both are pinned now; moving one means moving the other, and the driver with them.
  */
private val rqliteVersion = "10.6.1"

/** Ensure an rqlite Docker container is running. Starts one if needed. */
private def ensureRqlite(containerName: String, hostPort: Int): String =
  // Check Docker is available
  println(s"[rqlite] Checking Docker availability...")
  val dockerCheck = os.proc("docker", "info").call(check = false, stderr = os.Pipe)
  if dockerCheck.exitCode != 0 then
    sys.error(s"Docker is not running or not accessible: ${dockerCheck.err.trim()}")

  // Check if container is already running
  println(s"[rqlite] Checking for existing container '$containerName'...")
  val running = os.proc("docker", "ps", "-q", "-f", s"name=$containerName").call().out.trim()

  /** Whether what is running is the image this build asks for.
    *
    * Reuse used to be decided by the container's name alone, which made a version bump invisible:
    * the containers from the previous version kept running and every suite went on testing against
    * an engine the build no longer declares. That is how 8.36.2 stayed here while production moved
    * to 10.6.1. `ensureLocalStack` grew the same check for the same reason.
    */
  val wantedImage = s"rqlite/rqlite:$rqliteVersion"
  val runningImage =
    if running.isEmpty then
      ""
    else
      os
        .proc("docker", "inspect", containerName, "--format", "{{.Config.Image}}")
        .call(check = false, stderr = os.Pipe)
        .out
        .trim()

  if running.nonEmpty && runningImage == wantedImage then
    println(s"[rqlite] Container '$containerName' already running")
  else
    if running.nonEmpty then
      println(
        s"[rqlite] '$containerName' runs $runningImage but the build asks for $wantedImage; recreating")
    // Clean up any stopped container with the same name, or the one just found on another image.
    os.proc("docker", "rm", "-f", containerName).call(check = false, stderr = os.Pipe)

    // Check if port is already in use
    val portCheck = os.proc("docker", "ps", "-q", "-f", s"publish=$hostPort").call().out.trim()
    if portCheck.nonEmpty then
      sys.error(s"[rqlite] Port $hostPort is already in use by another container")

    println(s"[rqlite] Starting container '$containerName' on port $hostPort...")
    val startResult = os
      .proc(
        "docker",
        "run",
        "-d",
        "--name",
        containerName,
        "-p",
        s"$hostPort:4001",
        "-e",
        "SQLITE_EXTENSIONS=sqlean,misc",
        s"rqlite/rqlite:$rqliteVersion")
      .call(check = false, stderr = os.Pipe)

    if startResult.exitCode != 0 then
      sys.error(s"[rqlite] Failed to start container: ${startResult.err.trim()}")

    println(s"[rqlite] Waiting for container to be ready...")
    var ready = false
    var attempts = 0
    while !ready && attempts < 30 do
      Thread.sleep(500)
      ready =
        scala
          .util
          .Try(os.proc("curl", "-sf", s"http://localhost:$hostPort/readyz").call())
          .isSuccess
      attempts += 1

    if !ready then
      // Grab container logs for diagnosis
      val logs = os
        .proc("docker", "logs", "--tail", "20", containerName)
        .call(check = false, stderr = os.Pipe)
      sys.error(
        s"[rqlite] Container '$containerName' failed to become ready after ${attempts * 500}ms.\n" +
          s"Container logs:\n${logs.out.trim()}\n${logs.err.trim()}")
  end if

  println(s"[rqlite] '$containerName' ready on port $hostPort")
  s"jdbc:rqlite:http://localhost:$hostPort"
end ensureRqlite

/** Starts LocalStack if it is not already up, creates the bucket, and returns its endpoint.
  *
  * The MCP server needs S3 to hand out upload URLs and store per-location assets. Against real AWS
  * that means an account and an identity; against LocalStack it means neither — it does not verify
  * signatures, so the dummy credentials below are enough for the SDK's signer and are never
  * checked.
  */
/** Shared by `mcp` (which starts the container) and `client` (which publishes into it), so the two
  * cannot disagree about where dev assets live.
  */
private val localStackContainer = "localstack-dev"
private val devBucket = "captal-assets-dev"

/** Pinned, and the same for both editions so a developer with a licence and one without are running
  * the same LocalStack rather than two.
  *
  * Not `:3`, which is where this was: a licence is checked against the image, and 3.8.1 (built
  * 2024-10-08) is refused outright — *"Your LocalStack license requires you to use localstack-pro
  * version 2026.3.0 or higher"*, after which the container exits 55 and the only trace is in
  * `docker logs`. LocalStack versions by date now; both repositories publish the same tags.
  */
private val localStackVersion = "2026.9.1"

/** S3 is all the free tier has of what this project touches. */
private val freeServices = "s3"

/** With a licence, everything `deploy_location` and its test fixture need.
  *
  * `ecs` and `elbv2` are the resources the tool creates beyond the log group, and both are
  * available from the Base plan — 57 of 77 ECS operations and 38 of 51 ELBv2 ones, including every
  * call this repo makes. `ec2` is for the fixture rather than the tool: a VPC, subnets and a
  * security group have to exist before `CreateLoadBalancer` and an awsvpc service will take them.
  *
  * The last four arrived with the Terraform fixture, which builds the whole shared stack rather
  * than the subset the tool touches: `efs` backs the single-node rqlite, `secretsmanager` holds the
  * backoffice's admin token, `servicediscovery` is the namespace rqlite is reached through, and
  * `ecr` is where the images would come from. A service missing here does not fail as "not
  * supported" — it comes back `UnrecognizedClientException`, which reads like a credentials problem
  * and is not one.
  */
// `route53` is not used directly: `servicediscovery.CreatePrivateDnsNamespace` refuses without it,
// because a private namespace *is* a hosted zone.
private val licensedServices =
  "s3,logs,ecs,elbv2,cloudfront,ec2,iam,sts,efs,secretsmanager,servicediscovery,route53,ecr"

/** The LocalStack licence, when the environment has one.
  *
  * Both spellings: `LOCALSTACK_AUTH_TOKEN` is what LocalStack documents, `LOCALSTACK_TOKEN` is what
  * this project's direnv calls it. Never logged — it is a credential, and the only thing worth
  * reporting is whether one was found.
  *
  * Takes the environment rather than reading `System.getenv`, which is wrong in a build: Mill runs
  * as a daemon that outlives the invocation, so `System.getenv` returns whatever was set when the
  * daemon started. Configuring the token and re-running then quietly keeps the free tier. `Task.env`
  * is the launching client's environment, which is what the rest of this file already uses.
  */
private def localStackToken(env: Map[String, String]): Option[String] = env
  .get("LOCALSTACK_AUTH_TOKEN")
  .orElse(env.get("LOCALSTACK_TOKEN"))
  .map(_.trim)
  .filter(_.nonEmpty)

/** The `SERVICES` a running container was actually started with.
  *
  * Docker cannot change the environment of a container that is already up, so "running" does not
  * mean "running what we asked for". Without this check a container started before the licence was
  * configured gets reused, `ecs` answers 501, and the build still says LocalStack is ready — the
  * failure then surfaces inside a test as an unhelpful `InternalFailure`.
  */
private def localStackEnv(containerName: String, key: String): Option[String] = os
  .proc("docker", "inspect", containerName, "--format", "{{range .Config.Env}}{{println .}}{{end}}")
  .call(check = false, stderr = os.Pipe)
  .out
  .lines()
  .collectFirst { case line if line.startsWith(s"$key=") => line.stripPrefix(s"$key=") }

private def localStackServices(containerName: String): Option[String] =
  localStackEnv(containerName, "SERVICES")

/** Whether IAM is being enforced, and softly or not, as one comparable string.
  *
  * Part of the reuse check for the reason above, and it matters more here than for `SERVICES`: a
  * container started before enforcement was asked for allows everything, so the suite passes while
  * testing nothing about the policy. That failure is invisible — there is no 501 and no error, just
  * a green run.
  */
private def localStackIam(containerName: String): String =
  val enforcing = localStackEnv(containerName, "ENFORCE_IAM").getOrElse("0")
  val soft = localStackEnv(containerName, "IAM_SOFT_MODE").getOrElse("0")
  s"$enforcing/$soft"

/** The image a running container was started from, for the same reason as the services above: a
  * version bump has to replace the container, and a licence refused by an old image is reported
  * only in `docker logs` after an exit 55.
  */
private def localStackImage(containerName: String): Option[String] = os
  .proc("docker", "inspect", containerName, "--format", "{{.Config.Image}}")
  .call(check = false, stderr = os.Pipe)
  .out
  .lines()
  .headOption
  .map(_.trim)
  .filter(_.nonEmpty)

private def ensureLocalStack(
    containerName: String,
    hostPort: Int,
    bucket: String,
    env: Map[String, String]): String =
  val endpoint = s"http://localhost:$hostPort"
  val token = localStackToken(env)
  val services =
    if token.isDefined then
      licensedServices
    else
      freeServices
  val image =
    if token.isDefined then
      s"localstack/localstack-pro:$localStackVersion"
    else
      s"localstack/localstack:$localStackVersion"
  // Enforcement only where it can work: both settings are licensed features, and without a token
  // there is no ECS or IAM to evaluate anything against anyway.
  //
  // Soft by default, and that is a documented limitation rather than a soft landing.
  // `IAM_SOFT_MODE` evaluates every request against the policy and logs the outcome without
  // denying; hard mode denies.
  //
  // Hard is unreachable because what this policy gates on is outside LocalStack's IAM coverage.
  // Its coverage page enumerates the condition keys it supports — the global ones, the tag ones,
  // and service-specific keys for EC2 and RAM only — and lists the services with enforcement
  // coverage, which does not include ECS. This policy gates ECS service calls on `ecs:cluster` and
  // `iam:PassRole` on `iam:PassedToService`, neither of which is in that list, and its own
  // simulator confirms the consequence: each flips from `implicitDeny` to `allowed` purely by
  // supplying the key. So hard mode would fail the deploy end-to-end test on coverage that was
  // never claimed, and the alternative — dropping the conditions — is weakening a production
  // policy to suit a local tool.
  //
  // S3 *is* in that coverage, which is why the one real finding here was an S3 one and why the
  // liveness check in `DeployE2ESpec` is an S3 call.
  //
  // `CAPTAL_IAM_SOFT=0` tries hard anyway, which is what to run when LocalStack starts supplying
  // them. `DeployE2ESpec` is what keeps soft mode honest: it reads the evaluation log and fails on
  // any denial that is not one of those two known gaps.
  val soft =
    if env.get("CAPTAL_IAM_SOFT").contains("0") then
      "0"
    else
      "1"
  val iam =
    if token.isDefined then
      s"1/$soft"
    else
      "0/0"

  val running = os.proc("docker", "ps", "-q", "-f", s"name=$containerName").call().out.trim()
  val reusable = running.nonEmpty && localStackServices(containerName).contains(services) &&
    localStackImage(containerName).contains(image) && localStackIam(containerName) == iam

  if reusable then
    println(
      s"[localstack] '$containerName' already running: $image, SERVICES=$services, ENFORCE_IAM/IAM_SOFT_MODE=$iam")
  else
    if running.nonEmpty then
      println(
        s"[localstack] '$containerName' is running ${localStackImage(containerName)
            .getOrElse("<unknown>")} with SERVICES=${localStackServices(containerName)
            .getOrElse("<unset>")} and IAM=${localStackIam(containerName)}, replacing it with $image / $services / $iam")
    os.proc("docker", "rm", "-f", containerName).call(check = false, stderr = os.Pipe)
    println(
      s"[localstack] Starting '$containerName' on port $hostPort (${
          if token.isDefined then
            "licensed"
          else
            "free tier"
        })...")
    // The licensed image, and the Docker socket with it: LocalStack runs an ECS task as a real
    // container, so without the socket `CreateService` succeeds and no task ever starts.
    val licensedArgs = token
      .toSeq
      .flatMap(value =>
        Seq(
          "-e",
          s"LOCALSTACK_AUTH_TOKEN=$value",
          "-e",
          "ENFORCE_IAM=1",
          "-e",
          s"IAM_SOFT_MODE=$soft",
          "-v",
          "/var/run/docker.sock:/var/run/docker.sock"))
    val started = os
      .proc(
        "docker",
        "run",
        "-d",
        "--name",
        containerName,
        "-p",
        s"$hostPort:4566",
        "-e",
        s"SERVICES=$services",
        licensedArgs,
        image)
      .call(check = false, stderr = os.Pipe)
    if started.exitCode != 0 then
      sys.error(s"[localstack] Failed to start: ${started.err.trim()}")

    var ready = false
    var attempts = 0
    var exited = Option.empty[String]
    while !ready && exited.isEmpty && attempts < 60 do
      Thread.sleep(1000)
      ready =
        scala.util.Try(os.proc("curl", "-sf", s"$endpoint/_localstack/health").call()).isSuccess
      // A container that has already stopped will never become ready, and waiting out the full
      // minute to say so buries the reason. License activation is the case to expect: it exits 55
      // within a couple of seconds, and the explanation is only in the log.
      if !ready then
        exited = os
          .proc("docker", "ps", "-a", "-f", s"name=$containerName", "--format", "{{.Status}}")
          .call(check = false, stderr = os.Pipe)
          .out
          .lines()
          .headOption
          .filter(_.startsWith("Exited"))
      attempts += 1
    if !ready then
      val logs = os
        .proc("docker", "logs", "--tail", "25", containerName)
        .call(check = false, stderr = os.Pipe)
      val why = exited.fold(s"Not ready after ${attempts}s")(status => s"Container $status")
      sys.error(s"[localstack] $why.\n${logs.out.trim()}\n${logs.err.trim()}")
  end if

  // Asked rather than assumed, because a licence that did not take looks exactly like one that did
  // until a test calls `ecs` and gets a 501 out of an SDK that reports it as `InternalFailure`. The
  // health endpoint lists the registry it actually built, so a missing service is caught here with
  // its own name on it.
  val declared = services.split(',').toSet
  val health = os
    .proc("curl", "-sf", s"$endpoint/_localstack/health")
    .call(check = false, stderr = os.Pipe)
    .out
    .text()
  val missing = declared.filterNot(service => health.contains(s"\"$service\""))
  if missing.nonEmpty then
    sys.error(
      s"[localstack] ${missing.toList.sorted.mkString(", ")} not in the registry. ${
          if token.isDefined then
            "A token was supplied, so either it is not valid for these services or the image does not carry them"
          else
            "No LOCALSTACK_AUTH_TOKEN / LOCALSTACK_TOKEN was set, and these are licensed services"
        }.")

  // Idempotent: creating a bucket that exists is not an error worth stopping for.
  os.proc("docker", "exec", containerName, "awslocal", "s3api", "create-bucket", "--bucket", bucket)
    .call(check = false, stderr = os.Pipe)

  // CORS, without which the upload page cannot PUT anything.
  //
  // The page sends the file's own `Content-Type`, and `video/mp4` is not one of the three types
  // CORS treats as safe — so the browser asks permission first with an OPTIONS, and a bucket with
  // no CORS configuration answers that with a 403. The PUT is never attempted and the failure
  // arrives after the operator has chosen a file.
  //
  // `*` for the origin because the page runs in a sandboxed frame, whose origin is either opaque
  // (sending `Origin: null`) or a host-generated sandbox domain; naming either one would be
  // guessing at something that is not ours to pin. This is a local bucket holding test videos.
  //
  // The real bucket needs the same configuration and does not get it from here. Until it does,
  // this works in dev and fails in production — see docs/MCP_IAM.md.
  val cors =
    """{"CORSRules":[{"AllowedOrigins":["*"],"AllowedMethods":["PUT","GET","HEAD"],"AllowedHeaders":["*"],"ExposeHeaders":["ETag"],"MaxAgeSeconds":3000}]}"""
  val corsResult = os
    .proc(
      "docker",
      "exec",
      containerName,
      "awslocal",
      "s3api",
      "put-bucket-cors",
      "--bucket",
      bucket,
      "--cors-configuration",
      cors)
    .call(check = false, stderr = os.Pipe)
  if corsResult.exitCode != 0 then
    sys.error(
      s"[localstack] Could not set CORS on '$bucket'; the upload page's PUT would be refused at the preflight: ${corsResult
          .err
          .trim()}")

  println(s"[localstack] '$containerName' ready on $endpoint, bucket $bucket (CORS set)")
  endpoint
end ensureLocalStack

/** One `awslocal` call inside the container, failing loudly with what AWS said.
  *
  * `docker exec` rather than the host's `aws`, matching how the bucket is created above and for the
  * same reasons: `awslocal` ships in the image already pointed at the right endpoint, and it needs
  * no credentials on the machine running the build.
  */
private def awslocal(containerName: String, args: String*): String =
  val result = os
    .proc("docker", "exec", containerName, "awslocal", args)
    .call(check = false, stderr = os.Pipe)
  if result.exitCode != 0 then
    sys.error(s"[localstack] awslocal ${args.mkString(" ")} failed: ${result.err.trim()}")
  result.out.trim()

/** An `awslocal` query that is allowed to find nothing.
  *
  * The CLI is inconsistent about absence: a `--query` into an empty list prints `None`, while
  * `describe-load-balancers --names` for a name that does not exist exits non-zero. Both mean the
  * same thing here, so both become `None`.
  */
private def awslocalOption(containerName: String, args: String*): Option[String] =
  val result = os
    .proc("docker", "exec", containerName, "awslocal", args)
    .call(check = false, stderr = os.Pipe)
  Option
    .when(result.exitCode == 0)(result.out.trim())
    .filter(value => value.nonEmpty && value != "None")

/** The shared infrastructure a deploy assumes already exists, created in LocalStack.
  *
  * [[whitelabel.captal.mcp.DeployTools]] creates five resources *per location* and reads the rest
  * from its environment, because in production those are applied with OpenTofu from another
  * repository. Nothing was standing them up locally, which is why `mcp.localStackSetup` only ever
  * made a bucket: the licensed services were available and no cluster, VPC or load balancer existed
  * for a deploy to attach to.
  *
  * Returned as the environment rather than as objects, so a test goes through `DeployTargets.layer`
  * and `AssetStore.layer` — the same reading of the same variables production does. A fixture that
  * built `DeployTargets` directly would skip the one part that has already gone wrong once.
  *
  * Every step is look-up-or-create, keyed on a `Name` tag, because `create-vpc` is not idempotent:
  * running twice without the lookup leaves two VPCs and a subnet in whichever one came back first.
  */
/** A CloudFront distribution in front of `bucket`, created once and found thereafter.
  *
  * Needed because `AssetStore` no longer has a way to not have one. It used to turn every
  * invalidation against a local endpoint into the string `"skipped-no-cdn"`, and the environment
  * handed it a made-up id -- which meant the whole CloudFront path was never executed by anything
  * until it reached AWS: `createInvalidation`, the poll to `Completed`, and the ordering in
  * `pause_location` that depends on the wait actually waiting.
  *
  * Looked up by `Comment` rather than tracked, the same shape as the other lookups here: the id is
  * generated, so a second run has to find the first run's distribution instead of adding one.
  *
  * Requires a licence. CloudFront is not in the free tier's registry, so callers that may run
  * without one have to be prepared for this to fail.
  */
private def ensureDistribution(containerName: String, comment: String, bucket: String): String =
  awslocalOption(
    containerName,
    "cloudfront",
    "list-distributions",
    "--query",
    s"DistributionList.Items[?Comment=='$comment'].Id | [0]",
    "--output",
    "text").getOrElse:
    awslocal(
      containerName,
      "cloudfront",
      "create-distribution",
      "--distribution-config",
      // Inline rather than a staged file: `os.proc` passes arguments without a shell, so the JSON
      // needs no quoting of its own. The legacy `ForwardedValues` form instead of a cache policy
      // id, which would otherwise have to be looked up from a managed policy LocalStack need not
      // have.
      s"""{"CallerReference":"$comment","Comment":"$comment","Enabled":true,
         |"Origins":{"Quantity":1,"Items":[{"Id":"assets","DomainName":"$bucket.s3.amazonaws.com",
         |"S3OriginConfig":{"OriginAccessIdentity":""}}]},
         |"DefaultCacheBehavior":{"TargetOriginId":"assets","ViewerProtocolPolicy":"allow-all",
         |"ForwardedValues":{"QueryString":false,"Cookies":{"Forward":"none"}},"MinTTL":0,
         |"TrustedSigners":{"Enabled":false,"Quantity":0}}}""".stripMargin.replace("\n", ""),
      "--query",
      "Distribution.Id",
      "--output",
      "text")

/** Where the OpenTofu configuration lives: `terraform/`, in this repository.
  *
  * It was a sibling repository, which made the local suite depend on a second clone sitting next to
  * this one — `mcp.test` could not run without it, and nothing said so until `tofu` failed on a
  * directory that was not there. It is a subtree now, with its nine commits, so one checkout is the
  * whole system.
  *
  * Still overridable, for the case the move does not cover: pointing at a working copy of the
  * configuration somewhere else while editing it.
  */
private def terraformDir(env: Map[String, String], repoRoot: os.Path): os.Path = env
  .get("CAPTAL_TERRAFORM_DIR")
  .map(os.Path(_, repoRoot))
  .getOrElse(repoRoot / "terraform")

/** The shared infrastructure a location deploy attaches to, applied from the real OpenTofu
  * configuration against LocalStack.
  *
  * `environment = "local"` is a real environment in that configuration, so what the suite attaches
  * to is what builds the deployed ones — the cluster, the listener, the security groups, the task
  * roles, the bucket and the distribution. A fixture assembled from `awslocal` calls agrees with
  * the configuration only for as long as someone keeps it agreeing.
  *
  * The state file lives under `stateDir`, which the caller keys by the LocalStack container id,
  * and that pairing is the whole operational contract here: **the state and the container have to
  * be born together.** LocalStack holds the resources and the state file holds the record of them,
  * so either one surviving without the other is a divergence tofu cannot repair — it plans a
  * create for something that exists and the apply fails with `AlreadyExists` on roles, buckets and
  * CloudFront policies. That is what [[resetLocalStack]] is for, and why the error below points at
  * it rather than trying to be clever.
  *
  * `backend.tf` is deliberately not staged. It declares an S3 backend whose bucket this same
  * configuration creates (`module.s3_backend`), which is a chicken-and-egg locally; dropping the
  * file leaves tofu's default local state, which is what `-state` then places.
  *
  * Applied rather than planned, every run. A plan is never clean here: LocalStack reports the ALB
  * listener's port as its own edge port, 4566, so tofu sees drift back to 80 on every evaluation
  * and corrects it to no effect. One in-place modification per run is the cost of that, and it is
  * why "no changes" cannot be used as a health check.
  */
private def ensureLocalStackTofu(
    endpoint: String,
    licensed: Boolean,
    configDir: os.Path,
    stateDir: os.Path): Map[String, String] =
  // Same signal production uses: no `ECS_CLUSTER` means the deploy tools are not registered and
  // the end-to-end test skips itself, rather than the suite failing on a machine that was never
  // going to run it. ECS and ELBv2 are not in the free tier's registry at all.
  if !licensed then
    println("[tofu] no LocalStack licence, so no infrastructure; the deploy end-to-end test will skip")
    Map.empty
  else

  if !os.exists(configDir) then
    sys.error(
      s"[tofu] no OpenTofu configuration at $configDir. It is a sibling repository; set CAPTAL_TERRAFORM_DIR if it lives elsewhere.")

  val staged = stateDir / "config"
  val state = stateDir / "terraform.tfstate"

  // Copied rather than used in place, so the configuration repository stays read-only from here:
  // `TF_DATA_DIR` keeps the provider cache out of it and this keeps `backend.tf` out of the copy.
  os.remove.all(staged)
  os.makeDir.all(staged)
  os.list(configDir)
    .filter(p => p.last.endsWith(".tf") && p.last != "backend.tf")
    .foreach(p => os.copy.into(p, staged))
  Seq("modules", "environments").foreach: dir =>
    os.copy(configDir / dir, staged / dir)
  val lock = configDir / ".terraform.lock.hcl"
  if os.exists(lock) then
    os.copy.into(lock, staged)

  // `-chdir=path` as one argument, not two: tofu parses it itself rather than through a flag
  // parser, and rejects the separated form.
  def tofu(args: String*): os.CommandResult = os
    .proc("tofu", s"-chdir=$staged", args)
    .call(
      env = Map("TF_DATA_DIR" -> (stateDir / ".terraform").toString, "TF_IN_AUTOMATION" -> "1"),
      check = false,
      stdout = os.Pipe,
      stderr = os.Pipe)

  def fail(what: String, result: os.CommandResult): Nothing =
    val output = (result.out.text() + result.err.text()).trim()
    // The one failure worth naming, because its message says nothing about its cause: the
    // resources are there and this state has never seen them.
    val diverged = output.contains("AlreadyExists") || output.contains("EntityAlreadyExists")
    sys.error(
      s"[tofu] $what failed.\n$output\n\n" + (
        if diverged then
          s"That is LocalStack holding resources this state does not know about — the two have come apart. Run `mill mcp.test.resetLocalStack` to recreate the container, which also discards $stateDir, and let the next run build both together."
        else
          ""
      ))

  val initialised = tofu("init", "-input=false")
  if initialised.exitCode != 0 then
    fail("init", initialised)

  println(s"[tofu] applying the local environment (minutes, on a fresh container)")
  val applied = tofu(
    "apply",
    "-auto-approve",
    "-input=false",
    "-var-file=environments/local/terraform.tfvars",
    s"-state=$state")
  if applied.exitCode != 0 then
    fail("apply", applied)

  val outputs = tofu("output", "-json", s"-state=$state")
  if outputs.exitCode != 0 then
    fail("output", outputs)

  val parsed = ujson.read(outputs.out.text()).obj
  def output(name: String): String = parsed
    .get(name)
    .map(_.obj("value").str)
    .filter(_.nonEmpty)
    .getOrElse(sys.error(
      s"[tofu] the apply reported success but output '$name' is missing or empty. Outputs present: ${parsed.keys.toSeq.sorted.mkString(", ")}"))

  /** An output that is `null` in an environment that does not produce it. */
  def optionalOutput(name: String): Option[String] = parsed
    .get(name)
    .map(_.obj("value"))
    .filterNot(_.isNull)
    .map(_.str)
    .filter(_.nonEmpty)

  println(
    s"[tofu] ready: cluster ${output("ecs_cluster_name")}, vpc ${output("vpc_id")}, distribution ${output("cloudfront_distribution_id")}")

  Map(
    "AWS_ENDPOINT_URL" -> endpoint,
    // Matches `aws_region` in the local tfvars. Literal rather than an output because it is an
    // input to that configuration, not something it decides.
    "AWS_REGION" -> "us-east-1",
    // The IAM user this configuration creates for `local`, carrying the same policy the deployed
    // task role does — so with `ENFORCE_IAM` on, a permission the policy does not grant fails here
    // instead of in front of an operator.
    //
    // `test`/`test` is the fallback and used to be unconditional, which was the problem: with
    // enforcement off LocalStack accepts any pair and allows everything, so the suite was
    // exercising its own calls and would have passed against an empty policy. Either way the pair
    // is set here rather than left to the machine, so no run picks up someone's real profile.
    "AWS_ACCESS_KEY_ID" -> optionalOutput("mcp_test_user_access_key_id").getOrElse("test"),
    "AWS_SECRET_ACCESS_KEY" -> optionalOutput("mcp_test_user_secret_access_key").getOrElse("test"),
    // The bucket this configuration creates, overriding the suite's own fallback below. It has to
    // be this one under IAM enforcement: `aws_iam_policy.mcp` grants the object actions on
    // `${assets_bucket_arn}/*`, so a bucket the configuration does not know about is denied. That
    // was measured with LocalStack's own simulator — `captal-local-assets` allowed,
    // `captal-assets-mcp-test` implicitDeny — and it is a fixture bug rather than a policy gap:
    // widening the policy to cover a test-only bucket would be granting production access to
    // something that only exists here.
    "ASSETS_BUCKET" -> output("assets_bucket_name"),
    "ECS_CLUSTER" -> output("ecs_cluster_name"),
    "VPC_ID" -> output("vpc_id"),
    "SUBNET_IDS" -> output("subnet_ids"),
    "SECURITY_GROUP_ID" -> output("ecs_tasks_security_group_id"),
    "ALB_LISTENER_ARN" -> output("alb_listener_arn"),
    "TASK_EXECUTION_ROLE_ARN" -> output("task_execution_role_arn"),
    "TASK_ROLE_ARN" -> output("task_role_arn"),
    // The distribution this configuration builds, whose origin is its own assets bucket rather
    // than the suite's. Nothing fetches through it — the spec calls `createInvalidation` and polls
    // for `Completed` — so the origin does not matter; the id being a real one does.
    "CLOUDFRONT_DISTRIBUTION_ID" -> output("cloudfront_distribution_id"),
    // Deliberately an image that is already on the machine. LocalStack runs an ECS task as a real
    // container, so a task definition naming an ECR repository nobody can pull would leave the
    // service trying forever. Nothing here waits for a task to start, but a pull that cannot
    // succeed is noise in the container's log that looks like a test failure.
    "API_IMAGE" -> s"rqlite/rqlite:$rqliteVersion"
  )
end ensureLocalStackTofu

// `ensureLocalStackInfra` was here: 219 lines that built a cluster, a VPC, two subnets, a security
// group, a load balancer, a listener and two IAM roles out of `awslocal` calls, each one wrapped in
// a describe-or-create to be idempotent. It agreed with the deployed topology only for as long as
// someone kept it agreeing, and `modules/alb` had already grown rules it did not know about.
// `ensureLocalStackTofu` applies the same configuration the AWS environments use.

// Shared by api.dev and mcp.dev on purpose: the backoffice writes what the portal reads, so they
// have to be looking at the same database to be worth running together.
private val rqliteDevPort = 4001
private val rqliteDevContainerName = "rqlite-dev"

// ─────────────────────────────────────────────────────────────────────────────
// Base traits
// ─────────────────────────────────────────────────────────────────────────────

trait BaseModule extends ScalaModule with ScalafmtModule with ScalafixModule:
  def scalaVersion = "3.8.0"
  def scalacOptions = Seq("-Wunused:imports,locals,explicits,implicits")

trait BaseJSModule extends ScalaJSModule with ScalafmtModule with ScalafixModule:
  def scalaVersion = "3.8.0"
  def scalaJSVersion = "1.20.1"
  def scalacOptions = Seq("-Wunused:imports,locals,explicits,implicits")

// ─────────────────────────────────────────────────────────────────────────────
// Core: JVM + JS (shared sources)
// ─────────────────────────────────────────────────────────────────────────────

trait CoreDepsJVM extends ScalaModule:
  def mvnDeps = Seq(
    mvn"org.typelevel::cats-core:2.12.0",
    mvn"io.circe::circe-core:0.14.10",
    mvn"io.circe::circe-generic:0.14.10",
    mvn"io.circe::circe-parser:0.14.10",
    mvn"io.taig::babel-core:0.5.3",
    mvn"io.taig::babel-generic:0.5.3",
    mvn"io.taig::babel-circe:0.5.3"
  )

trait CoreDepsJS extends ScalaJSModule:
  def mvnDeps = Seq(
    mvn"org.typelevel::cats-core::2.12.0",
    mvn"io.circe::circe-core::0.14.10",
    mvn"io.circe::circe-generic::0.14.10",
    mvn"io.circe::circe-parser::0.14.10",
    mvn"io.github.cquiroz::scala-java-time::2.6.0",
    mvn"io.taig::babel-core::0.5.3",
    mvn"io.taig::babel-generic::0.5.3",
    mvn"io.taig::babel-circe::0.5.3"
  )

object core extends BaseModule with CoreDepsJVM:
  object test extends ScalaTests with TestModule.Utest with ScalafmtModule with ScalafixModule:
    def mvnDeps = Seq(mvn"com.lihaoyi::utest:0.8.9", mvn"org.scalacheck::scalacheck:1.18.0")

object `core-js` extends BaseJSModule with CoreDepsJS:
  def sources = core.sources

// `endpoints` and `endpoints-js` were here: a cross-compiled module holding the tapir endpoint
// descriptions and, beside them, the request and response types the browser reads.
//
// The pairing was the problem. `endpoints-js` compiled every source in the module, so the browser
// build carried tapir on its compile classpath to typecheck declarations nothing in the browser
// reads — the linker dropped them, 0 of 188 output modules mention tapir, but the dependency and
// the compile were real. And the shared contract it was supposed to be was not how the server
// actually worked: `SurveyEndpoints`, `VideoEndpoints` and `FinishEndpoints` had no reference
// anywhere, `LocaleEndpoints` had two of its five used, and every other route already built its
// endpoint inline in `api` on `SessionEndpoint`.
//
// So the descriptions were deleted, the two live ones moved into `LocaleRoutes` beside the three
// that were already there, and the tapir `Schema` instances became `api.schemas`, in the one module
// that still has tapir in it. What was genuinely shared became `messages` below.

// ─────────────────────────────────────────────────────────────────────────────
// Messages: JVM + JS (shared sources) — the request and response vocabulary
// ─────────────────────────────────────────────────────────────────────────────

// What `api` answers with and `client` reads: the requests, the responses, `ApiError`, and the
// circe codecs for the translation bundle. Cross-compiled because both sides need the same types,
// which is the one thing the module it replaces was right about.
//
// Named for what it holds rather than for a layer. `endpoints` invited endpoint descriptions and
// collected 174 lines of dead ones; `http` or `api-shared` would read as a layer and invite the
// same. A tapir description is not a message, and the name says so.
//
// These lived in `core.codecs` for part of this refactor, which was wrong for the reason the name
// gave away: `ApiError` is an HTTP error vocabulary — `{"error": …, "data": …}` — and `core` has no
// business knowing one. It depends on `core` rather than the reverse, which is the right direction:
// these types translate domain errors and commands into what crosses the wire.
// `-Xmax-inlines` above the default 32 in both: `ApiError` has exactly 32 variants and circe's
// derivation inlines once per case, so it fails with "Maximal number of successive inlines (32)
// exceeded" — a compiler limit reached rather than a type that is too large. Raising it is what
// lets both codec directions be derived, and the alternative is the hand-written pair that had
// drifted twenty-two variants apart.
object messages extends BaseModule:
  def moduleDeps = Seq(core)
  def scalacOptions = super.scalacOptions() ++ Seq("-Xmax-inlines:64")
  def mvnDeps = Seq(
    mvn"io.circe::circe-core:0.14.10",
    mvn"io.circe::circe-generic:0.14.10",
    mvn"io.circe::circe-parser:0.14.10")

object `messages-js` extends BaseJSModule:
  def moduleDeps = Seq(`core-js`)
  def sources = messages.sources
  def scalacOptions = super.scalacOptions() ++ Seq("-Xmax-inlines:64")
  def mvnDeps = Seq(
    mvn"io.circe::circe-core::0.14.10",
    mvn"io.circe::circe-generic::0.14.10",
    mvn"io.circe::circe-parser::0.14.10")

// ─────────────────────────────────────────────────────────────────────────────
// Infra: JVM only
// ─────────────────────────────────────────────────────────────────────────────

object platform extends BaseModule:
  def moduleDeps = Seq(core)
  def mvnDeps = Seq(
    mvn"dev.zio::zio:2.1.14",
    mvn"dev.zio::zio-http:3.0.1",
    mvn"io.getquill::quill-jdbc-zio:4.8.6",
    mvn"com.github.geirolz::fly4s:1.0.8",
    mvn"dev.zio::zio-interop-cats:23.1.0.3",
    // 10.5.2.1 and not 9.1.2.1, and the release note is the reason: "failed statements, batches
    // and commits now throw instead of being silently ignored". On 9.1.2.1 a statement the
    // database refused came back as zero affected rows inside an HTTP 200, raising nothing — which
    // `wrapForMigrations` and `Migrate.Lock` are both written around, and which bit three separate
    // times in one afternoon.
    //
    // It also pairs with the server. The driver's version tracks rqlite's, and production had
    // drifted to 10.6.1 while this said 9.1.2 and the test fixture ran 8.36.2 — three combinations,
    // none of them the one the driver targets. Since rqlite v10.6.0 a failed statement carries
    // SQLite result codes that only this driver decodes, so the pair is what makes an error
    // identifiable by code rather than by matching its text.
    mvn"io.rqlite:rqlite-jdbc:10.5.2.1",
    mvn"ch.qos.logback:logback-classic:1.5.6",
    mvn"io.circe::circe-yaml:0.16.0"
  )

  def migrate() = Task.Command:
    runMain("whitelabel.captal.platform.Migrate")()

  // `dockerBuild` and `dockerPush` built and shipped `captal-provision`, an image whose only
  // process was `SharedProvision`. With the ephemeral provisioning task gone there is nothing to
  // run in it. The ECR repositories `captal-provision-{env}` and `captal-shared-{env}` are now
  // unreferenced; emptying and removing them is a `tofu apply` under `terraform/`, not
  // something this build can do.
end platform

// ─────────────────────────────────────────────────────────────────────────────
// API: JVM only (server implementation)
// ─────────────────────────────────────────────────────────────────────────────

object api extends BaseModule:
  // `endpoints` was in here and is gone, and so is the tapir it carried. `messages` holds what the
  // browser actually shared with this module — the request and response types — and the route
  // descriptions live beside the routes, which is the only place that ever read them.
  def moduleDeps = Seq(core, messages, platform)

  def dockerfile: T[PathRef] = Task.Source(moduleDir / os.up / "Dockerfile.api")

  /** Build the API image. Usage: `./mill api.image` or `./mill api.image --tag v1.2.3`
    *
    * The same shape as `mcp.image`, and for the reason recorded on `Dockerfile.api`: the previous
    * arrangement compiled inside the image and had been unbuildable for two separate reasons, each
    * of which nothing would catch because nothing builds this image in CI. A task that produces it
    * from the jar Mill already has is both faster and checkable.
    */
  def image(tag: String = "latest") = Task.Command:
    val context = Task.dest / "context"
    os.makeDir.all(context)
    os.copy.over(assembly().path, context / "api.jar")
    os.copy.over(dockerfile().path, context / "Dockerfile")

    val name = s"captal-api:$tag"
    val built = os
      .proc("docker", "build", "-t", name, ".")
      .call(cwd = context, check = false, stdout = os.Inherit, stderr = os.Inherit)
    if built.exitCode != 0 then
      sys.error("[image] docker build failed")
    println(s"[image] built $name")
    name
  // tapir was here — `tapir-zio-http-server` and `tapir-json-circe` — and is gone with the last
  // route that used it. What it gave was a description of an endpoint as a value; zio-http's own
  // `Endpoint` gives the same thing, and the server was already running on zio-http underneath,
  // interpreted into it by `ZioHttpInterpreter`.
  //
  // zio-schema comes in anyway, since `zio-http` resolves 1.4.1 of it, and that is where a `Schema`
  // stops being documentation beside circe and becomes the codec `Endpoint` serialises with. Only
  // `derivation` has to be asked for.
  def mvnDeps = Seq(
    mvn"dev.zio::zio-schema-derivation:1.4.1",
    mvn"dev.zio::zio-interop-cats:23.1.0.3"
  )

  // No PROVISION_DIR: the API no longer provisions. Content is written through the MCP backoffice
  // and read from the database, so a dev server that re-applied a directory on every start would
  // overwrite whatever was edited since — which is exactly what it used to do.
  override def forkEnv: T[Map[String, String]] = Task:
    Map("LOCATION_SLUG" -> defaultLocationSlug) ++ super.forkEnv()

  // Render index.html from template for local development.
  // CLIENT_LINKER=full points at the bundle Vite processed (fullLinkJS → rollup → terser), which
  // is what production actually serves; the default `fast` uses fastLinkJS with no post-processing.
  def copyIndex() = Task.Command:
    val root = moduleDir / os.up
    val jsPath =
      Task.env.getOrElse("CLIENT_LINKER", "fast") match
        case "full" =>
          "/out/client/bundle.dest/main.js"
        case _ =>
          "/out/client/fastLinkJS.dest/main.js"
    renderIndex(
      root / "client" / "index.html.template",
      root / "client" / "index.html",
      jsPath = jsPath,
      cssPath = "/assets/styles.css")

  // The dev provisioning YAML under `api/resources/provision/dev` is no longer read by anything.
  // Left on disk rather than deleted here: `ProvisionService`, the `provision` module and the CLI
  // that writes those files are still present, and removing the data before the code that reads it
  // would leave a build that compiles and a CLI that cannot run.
  private val defaultLocationSlug = "cafe-centro"

  def rqliteSetup() = Task.Command:
    ensureRqlite(rqliteDevContainerName, rqliteDevPort)

  def stopRqlite() = Task.Command:
    os.proc("docker", "rm", "-f", rqliteDevContainerName).call(check = false)
    println("rqlite test container stopped")

  // Compile client before running server
  override def run(args: Task[Args] = Task.Anon(Args())) = Task.Command:
    copyIndex()()
    if Task.env.getOrElse("CLIENT_LINKER", "fast") == "full" then
      client.bundle()
    else
      client.fastLinkJS()
    super.run(args)()

  /** Full dev workflow: rqlite + migrations + client + server. Usage: ./mill api.dev, or ./mill
    * api.dev --slug basic to serve another location.
    *
    * No longer takes a provisioning directory. The server reads what the backoffice wrote; seeding
    * a fresh database is `mill mcp.dev` and the tools, not a directory replayed at startup.
    */
  def dev(slug: String = defaultLocationSlug) = Task.Command:
    println("[dev] Step 1/3: Ensuring rqlite container...")
    rqliteSetup()()
    println("[dev] Step 2/3: Running migrations...")
    platform.migrate()()
    println(s"[dev] Step 3/3: Starting server (location=$slug)...")
    copyIndex()()
    if Task.env.getOrElse("CLIENT_LINKER", "fast") == "full" then
      client.bundle()
    else
      client.fastLinkJS()
    val cp = runClasspath().map(_.path.toString).mkString(java.io.File.pathSeparator)
    val mc = "whitelabel.captal.api.Main"
    val env = forkEnv() ++ Map("LOCATION_SLUG" -> slug)
    os.proc("java", forkArgs(), "-cp", cp, mc)
      .call(env = env, stdin = os.Inherit, stdout = os.Inherit, stderr = os.Inherit)

  object test extends ScalaTests with ScalafmtModule with ScalafixModule:
    // `tapir-sttp-stub-server` was here, and sttp-client came in behind it. The suites never used
    // the tapir half: they send `basicRequest` and `TestHelpers` answers with an
    // `SttpBackendStub`, which is sttp-client's own. So the client is declared directly now, at
    // the version tapir had been resolving.
    def mvnDeps = Seq(
      mvn"dev.zio::zio-test:2.1.14",
      mvn"dev.zio::zio-test-sbt:2.1.14",
      mvn"com.softwaremill.sttp.client3::core:3.10.2")
    def testFramework = "zio.test.sbt.ZTestFramework"

    private val rqliteTestPort = 4011
    private val rqliteContainerName = "rqlite-test"

    // Task.Input runs on every invocation (not cached on inputs like Task), so
    // each `mill api.test` re-verifies that the Docker container is actually
    // alive and starts it if missing. Plain `Task` would cache the URL and
    // never re-check, which silently fails when the operator removes the
    // container between runs (we hit exactly that footgun before — symptoms:
    // tests hang on "HTTP POST error: (-1) [http://localhost:4011/...]").
    def rqliteTestUrl: T[String] = Task.Input:
      ensureRqlite(rqliteContainerName, rqliteTestPort)

    override def forkEnv: T[Map[String, String]] = Task:
      super.forkEnv() ++ Map("TEST_DB_URL" -> rqliteTestUrl())

    def stopRqlite() = Task.Command:
      os.proc("docker", "rm", "-f", rqliteContainerName).call(check = false)
      println("rqlite test container stopped")
  end test

  /** Build the dev Docker image (uses Dockerfile.api with SERVER_DEV_ENDPOINTS=true). Usage: ./mill
    * api.dockerBuildDev captal-dev 0.1.0
    */
  def dockerBuildDev(name: String, version: String) = Task.Command:
    val root = moduleDir / os.up
    val tag = s"$name:$version"
    println(s"[docker] Building $tag ...")
    val result = os
      .proc(
        "docker",
        "build",
        "-f",
        (root / "Dockerfile.api").toString,
        "--build-arg",
        "SERVER_DEV_ENDPOINTS=true",
        "-t",
        tag,
        root.toString)
      .call(check = false, stderr = os.Pipe)
    if result.exitCode != 0 then
      sys.error(s"[docker] Build failed:\n${result.err.trim()}")
    println(s"[docker] Built $tag")

  /** Build production base image captal-api. Usage: ./mill api.dockerBuild <ecr-repo-uri> <tag>
    */
  def dockerBuild(repoUri: String, tag: String) = Task.Command:
    val root = moduleDir / os.up
    val fullTag = s"$repoUri:$tag"
    println(s"[docker] Building $fullTag ...")
    val result = os
      .proc(
        "docker",
        "build",
        "-f",
        (root / "Dockerfile.api").toString,
        "-t",
        fullTag,
        root.toString)
      .call(check = false, stderr = os.Pipe)
    if result.exitCode != 0 then
      sys.error(s"[docker] Build failed:\n${result.err.trim()}")
    println(s"[docker] Built $fullTag")

  /** Push image to ECR. Operator must run `aws ecr get-login-password | docker login` first. Usage:
    * ./mill api.dockerPush <ecr-repo-uri> <tag>
    */
  def dockerPush(repoUri: String, tag: String) = Task.Command:
    val fullTag = s"$repoUri:$tag"
    println(s"[docker] Pushing $fullTag ...")
    val result = os.proc("docker", "push", fullTag).call(check = false, stderr = os.Pipe)
    if result.exitCode != 0 then
      sys.error(s"[docker] Push failed:\n${result.err.trim()}")
    println(s"[docker] Pushed $fullTag")
end api

// ─────────────────────────────────────────────────────────────────────────────
// Client: JS only (Laminar app)
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// Client: JS only (Laminar app)
// ─────────────────────────────────────────────────────────────────────────────

// `mcpui` y `maintenance` vivían acá, cada uno con su propio linker run. Ahora son módulos
// públicos de `client`: cuatro entry points de un run, con las fuentes bajo `client/src` y los
// stubs bajo `client/entries`. Lo que cada uno ganaba por separado era su propio runtime — y
// `maintenance`, además, el Closure Compiler, que no corre sobre output ESModule.
object client extends BaseJSModule:
  // `core-js` alone now. The request and response types this reads are `core.codecs`, which
  // `core-js` cross-compiles; `endpoints-js` existed only to share a module with the tapir
  // descriptions, and brought tapir into this build to typecheck them.
  def moduleDeps = Seq(`core-js`, `messages-js`)

  /** Two settings the linker defaults leave on the table, and the second is the one that pays.
    *
    * `allowBigIntsForLongs` backs `Long` with the browser's own `BigInt` instead of emulating it
    * with a pair of 32-bit ints, which removes `RuntimeLong` from the bundle entirely — verified,
    * zero references left. It needs ES2020 for `BigInt` to exist, hence the version bump, which
    * also lets the emitter use newer syntax and emit less of it.
    *
    * The trade is arithmetic speed: `BigInt` is slower than the emulation for hot loops. Nothing
    * here has one — `Long` survives in a countdown and a few timestamps.
    */
  def esFeatures = mill
    .scalajslib
    .api
    .ESFeatures
    .Defaults
    .withESVersion(mill.scalajslib.api.ESVersion.ES2021)
    .withAllowBigIntsForLongs(true)

  /** Required for the per-route dynamic imports: `NoModule` emits exactly one module and refuses
    * `js.dynamicImport` outright ("module support is disabled").
    *
    * The cost is the Closure Compiler, which Scala.js runs only for a single module — with more
    * than one it errors outright under CommonJS and silently skips under ESModule. Losing it is why
    * the bundling step below exists: esbuild scope-hoists each chunk back into one scope and terser
    * mangles it, which recovers most of what Closure did.
    */
  def moduleKind = mill.scalajslib.api.ModuleKind.ESModule
  def moduleSplitStyle = mill.scalajslib.api.ModuleSplitStyle.SmallModulesFor("whitelabel.captal")
  def mvnDeps = Seq(
    mvn"com.raquo::laminar::17.2.0",
    mvn"com.raquo::waypoint::9.0.0",
    // Declared rather than taken from Laminar's own graph: the MCP App pages use nothing but the
    // DOM, and a Laminar bump that changed this version would move them without naming them.
    mvn"org.scala-js::scalajs-dom::2.8.0",
    mvn"io.github.cquiroz::scala-java-time::2.6.0")

  // Generate BuildInfo with environment at build time
  def generatedSources: T[Seq[PathRef]] = Task:
    val env = Task.env.getOrElse("ENVIRONMENT", "production")
    val isDevMode = env == "dev"
    val dest = Task.dest / "BuildInfo.scala"
    os.write(
      dest,
      s"""package whitelabel.captal.client
         |
         |object BuildInfo:
         |  val environment: String = "$env"
         |  val isDevMode: Boolean = $isDevMode
         |""".stripMargin
    )
    Seq(PathRef(Task.dest))

  private def gzipFile(src: os.Path, dest: os.Path): Unit =
    val in = java.io.FileInputStream(src.toIO)
    val out = java.util.zip.GZIPOutputStream(java.io.FileOutputStream(dest.toIO))
    try
      val buf = new Array[Byte](8192)
      var n = in.read(buf)
      while n > 0 do
        out.write(buf, 0, n)
        n = in.read(buf)
    finally
      out.close()
      in.close()

  def clientAssets: T[PathRef] = Task.Source(moduleDir / "assets")
  def clientTemplate: T[PathRef] = Task.Source(moduleDir / "index.html.template")
  def maintenanceTemplate: T[PathRef] = Task.Source(moduleDir / "maintenance.html.template")

  /** The hand-written entries that call `start`, staged beside the linker's output. One per public
    * module that is not the portal: `main` carries this run's single module initializer.
    */
  def entries: T[PathRef] = Task.Source(moduleDir / "entries")

  def viteConfig: T[PathRef] = Task.Source(moduleDir / "vite.config.mjs")

  /** Vite, installed into the task's own directory.
    *
    * Needed because Scala.js emits more than one module for the per-route splitting, and the
    * Closure Compiler only runs for a single one. Vite's production build is Rollup, which
    * scope-hoists each chunk back into a single scope — that is what makes the names manglable
    * again — plus terser to mangle them. Measured against esbuild driving the same terser, Rollup
    * is 1 854 bytes better on the first paint and 7 621 on the total, and folds the eager half into
    * one chunk instead of two.
    */
  def jsTools: T[PathRef] = Task:
    val result = os
      .proc(
        "npm",
        "install",
        "--no-save",
        "--no-audit",
        "--no-fund",
        "--silent",
        "--prefix",
        Task.dest.toString,
        "vite@6.0.7",
        "terser@5.37.0")
      .call(check = false, stderr = os.Pipe)
    if result.exitCode != 0 then
      sys.error(s"[bundle] npm install failed: ${result.err.trim()}")
    PathRef(Task.dest)

  /** Build the production bundle. Usage: `./mill client.bundle` Output: out/client/bundle.dest/
    *
    * Nothing is pre-gzipped, and that is a consequence rather than a preference: a browser loading
    * an ES module imports the chunks by the exact path the linker wrote, so a file cannot be
    * renamed to `.gz`. CloudFront compresses on the fly instead — its default behaviour already has
    * `compress = true`, and it does brotli, which beats what was being shipped.
    */
  def bundle = Task:
    val linked = fullLinkJS().dest.path
    val assets = clientAssets().path
    val dest = Task.dest

    // Vite builds a project directory, so one is staged: the linker's output as `src/`, the
    // versioned config beside it, and `node_modules` symlinked from the tool task.
    val project = os.temp.dir(prefix = "captal-vite")
    os.makeDir.all(project / "src")
    for
      module <- os.list(linked)
      if module.ext == "js"
    do
      os.copy(module, project / "src" / module.last)
    // After the linker's output, so a stub named like a public module is caught as a collision
    // rather than silently overwriting it.
    for
      entry <- os.list(entries().path)
      if entry.ext == "js"
    do
      if os.exists(project / "src" / entry.last) then
        sys.error(
          s"[bundle] ${entry.last} is both a hand-written entry and a module the linker emitted. Rename the Scala.js moduleID.")
      os.copy(entry, project / "src" / entry.last)
    os.copy(viteConfig().path, project / "vite.config.mjs")
    os.symlink(project / "node_modules", jsTools().path / "node_modules")

    val built = os
      .proc((project / "node_modules" / ".bin" / "vite").toString, "build")
      .call(cwd = project, check = false, stderr = os.Pipe)
    if built.exitCode != 0 then
      sys.error(s"[bundle] vite build failed: ${built.err.trim()}")

    for
      output <- os.list(project / "dist")
      if output.ext == "js"
    do
      os.copy(output, dest / output.last)

    os.copy(assets / "styles.css", dest / "styles.css")
    os.copy(assets / "brand-icon.svg", dest / "brand-icon.svg")

    // Relative paths so the browser resolves them against the current directory, which in
    // production is https://<host>/<slug>/.
    renderIndex(
      clientTemplate().path,
      dest / "index.html",
      "./main.js",
      "./styles.css",
      preloadLinks(dest, "main.js"))
    renderIndex(
      maintenanceTemplate().path,
      dest / "maintenance.html",
      "./maintenance.js",
      "./styles.css",
      preloadLinks(dest, "maintenance.js"))

    PathRef(dest)

  /** The prefix both MCP App pages name. Flat, because Rollup writes the chunk import as
    * `./<name>-<hash>.js` and the browser resolves that against the entry's own URL.
    */
  private val uiPrefix = "ui"

  /** The two entries the MCP App pages load, and nothing else. */
  private val uiEntries = Seq("upload.js", "unifi.js")

  /** Every local module reachable from `roots`, by reading the `import`s Rollup wrote.
    *
    * This exists because of the merge. While the MCP App pages were their own linker run, every
    * chunk in their bundle belonged to them and `publish` could take the whole directory. Sharing a
    * run with the portal means the directory now also holds `main.js`, `maintenance.js` and the
    * portal's route chunks, none of which belong under `ui/` — and the chunks the two pages *do*
    * import are shared with the portal, so they cannot be told apart by name either. The only
    * honest selector left is the import graph.
    */
  private def moduleClosure(dir: os.Path, roots: Seq[String]): Set[String] =
    val Import = """(?:from|import)\s*"\./([^"]+)"""".r
    def walk(name: String, seen: Set[String]): Set[String] =
      if seen.contains(name) || !os.exists(dir / name) then seen
      else
        Import
          .findAllMatchIn(os.read(dir / name))
          .map(_.group(1))
          .foldLeft(seen + name)((acc, next) => walk(next, acc))
    roots.foldLeft(Set.empty[String])((acc, root) => walk(root, acc))

  /** Publish the two MCP App pages' scripts. Usage:
    * `./mill client.publish --bucket captal-dev-assets`
    *
    * Three rules, and each one is load-bearing:
    *
    *   - **Chunks before entries.** An entry published ahead of the chunk it imports is a 404 on an
    *     `import`, which renders as a page that loads and does nothing — no error the operator can
    *     see. The reverse order has no window at all: an unreferenced chunk is inert.
    *   - **Entries revalidate, chunks are immutable.** The server renders `<script src=".../ui/
    *     upload.js">` as a constant and must not know anything about the content, so the entry name
    *     is stable and the browser has to ask whether it changed — a 304 is ~200 bytes against the
    *     9 KB this replaces. The chunks carry a content hash and are only ever referenced by an
    *     entry, so they can be cached for a year.
    *   - **Old chunks are not deleted.** A browser mid-session holds an entry that imports a hash
    *     this deploy replaced, and CloudFront may still serve a previous entry until `s-maxage`
    *     runs out. They are small and immutable; collect them by age, never on deploy.
    *
    * `Access-Control-Allow-Origin: *` because a `<script type="module">` is fetched in CORS mode,
    * unlike a classic one — so without it the module fails to load and the page is inert. `*` and
    * not the sandbox origin: these are public JavaScript files with no credentials and no data, and
    * the sandbox origin is derived from our own server URL, so pinning it adds a way to break
    * without adding protection.
    */
  def publish(bucket: String, region: String = "us-east-1", endpoint: String = "") =
    Task.Command:
      val src = bundle().path
      val Revalidate = "public, max-age=0, must-revalidate, s-maxage=86400"
      val Immutable = "public, max-age=31536000, immutable"
      val missing = uiEntries.filterNot(name => os.exists(src / name))
      if missing.nonEmpty then
        sys.error(s"[publish] missing from $src: ${missing.mkString(", ")}")
      val (entries, chunks) =
        moduleClosure(src, uiEntries).toSeq.sorted.partition(uiEntries.contains)

      // Two transports for one operation. Against LocalStack the copy runs *inside* the container
      // with `awslocal`, which is what `ensureLocalStack` already does and for the same reason:
      // `aws` is not on the PATH Mill gives a subprocess, so a dev loop that needed it would work
      // only on a machine that happens to have it. `docker cp` first, since `docker exec` cannot
      // read a host file.
      val local = endpoint.nonEmpty
      def put(name: String, cache: String): Unit =
        val target = s"s3://$bucket/$uiPrefix/$name"
        val metadata = Seq(
          "--content-type",
          "application/javascript",
          "--cache-control",
          cache,
          "--metadata-directive",
          "REPLACE")
        println(s"[publish] $name -> $target")
        val result =
          if local then
            val staged = s"/tmp/$name"
            val copied = os
              .proc("docker", "cp", (src / name).toString, s"$localStackContainer:$staged")
              .call(check = false, stderr = os.Pipe)
            if copied.exitCode != 0 then
              sys.error(s"[publish] docker cp failed for $name: ${copied.err.trim()}")
            os.proc(
              Seq("docker", "exec", localStackContainer, "awslocal", "s3", "cp", staged, target) ++
                metadata)
              .call(check = false, stderr = os.Pipe)
          else
            os.proc(
              Seq("aws", "s3", "cp", (src / name).toString, target, "--region", region) ++
                metadata)
              .call(check = false, stderr = os.Pipe)
        if result.exitCode != 0 then
          sys.error(s"[publish] s3 cp failed for $name: ${result.err.trim()}")
      end put

      chunks.foreach(put(_, Immutable))
      entries.foreach(put(_, Revalidate))
      println(s"[publish] ${chunks.size} chunk(s) then ${entries.size} entr(ies)")

  /** Publish the bundle to S3 under `<bucket>/<prefix>/`. Replaces 4 manual `aws s3 cp` invocations
    * and ensures Content-Type / Content-Encoding metadata stay consistent.
    *
    * Usage: `./mill client.publishS3 --bucket captal-dev-assets --prefix bundle` Optional:
    * `--region us-east-1` (default).
    *
    * Operator must run `aws sso login` or have AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY set.
    */
  def publishS3(bucket: String, prefix: String, region: String = "us-east-1") = Task.Command:
    val src = bundle().path
    val normalizedPrefix = prefix.stripSuffix("/")
    val destBase = s"s3://$bucket/$normalizedPrefix"
    // Cache-Control is part of the contract rather than a tuning knob. Left unset, browsers fall
    // back to heuristic freshness -- roughly a tenth of the object's age -- so the staleness window
    // *grows* the longer a location goes without a deploy, and nothing here can bound it. A day is
    // the bound.
    //
    // The two HTML files are the exception, because which of them the edge serves is decided per
    // request and a browser that does not ask cannot be told the answer changed. `s-maxage` still
    // gives CloudFront its 24h; the invalidation every deploy issues is what clears that copy.
    val Day = "public, max-age=86400"
    val Revalidate = "public, max-age=0, must-revalidate, s-maxage=86400"

    // Enumerated from what the build produced rather than listed: the chunk names carry a content
    // hash chosen at bundle time, so no fixed list could name them. Nothing is pre-gzipped —
    // CloudFront compresses on the fly, which it must, since an ES module imports its chunks by the
    // exact path the linker wrote and those cannot be renamed.
    def contentType(name: String): String =
      if name.endsWith(".html") then
        "text/html; charset=utf-8"
      else if name.endsWith(".js") then
        "application/javascript"
      else if name.endsWith(".css") then
        "text/css"
      else if name.endsWith(".svg") then
        "image/svg+xml"
      else
        "application/octet-stream"

    // The MCP App pages live in this directory and do not belong under a location's prefix.
    //
    // They arrived with the merge: `client` emits four public modules out of one linker run, so
    // `upload.js`, `unifi.js` and the chunks they reach now sit beside the portal's. This published
    // the whole directory, and `Assets.copyBundle` copies `bundle/` into every `<slug>/` -- so every
    // location would carry a copy of the backoffice's pages at a path nothing addresses. They go to
    // `ui/` once, through `client.publish`.
    //
    // Subtracted by the import graph and not by name, for the reason `client.publish` needs the
    // same: sharing a linker run with the portal, a chunk is named after whichever module it grew
    // from, so no prefix distinguishes them. The difference is what *only* the UI pages reach --
    // the runtime they share with the portal stays, because the portal needs it here.
    val uiReaches = moduleClosure(src, uiEntries)
    val portalReaches = moduleClosure(src, Seq("main.js", "maintenance.js"))
    val uiOnly = uiReaches.diff(portalReaches)

    val files = os
      .list(src)
      .filter(os.isFile)
      .map(_.last)
      .filterNot(uiOnly.contains)
      .sorted
      .map(name =>
        (
          name,
          contentType(name),
          if name.endsWith(".html") then
            Revalidate
          else
            Day
        ))

    for (name, ctype, cache) <- files do
      val args = Seq(
        "aws",
        "s3",
        "cp",
        (src / name).toString,
        s"$destBase/$name",
        "--region",
        region,
        "--content-type",
        ctype,
        "--cache-control",
        cache)
      println(s"[publish] $name -> $destBase/$name")
      val result = os.proc(args).call(check = false, stderr = os.Pipe)
      if result.exitCode != 0 then
        sys.error(s"[publish] aws s3 cp failed for $name: ${result.err.trim()}")
    println(s"[publish] uploaded bundle to $destBase")
end client

// ─────────────────────────────────────────────────────────────────────────────
// MCP: backoffice server. Its own deployable, deliberately not linked into `api`.
//
// zio-http-mcp 0.5.0 is built against Scala 3.8.4 / zio-http 3.11.3, while the rest of the
// build is on 3.8.0 / 3.0.1. Scala 3 can read TASTy from the same or an older compiler, so a
// 3.8.4 module may depend on 3.8.0 ones but not the reverse — which is exactly why the version
// bump is contained here instead of applied build-wide.
//
// Depending on `platform` also pulls its zio-http 3.0.1, which Coursier evicts up to the 3.11.3 that
// zio-http-mcp requires — but only inside THIS module's classpath; `api` still resolves 3.0.1.
// `UnifiClient` is the single file in `platform` compiled against zio-http, and the backoffice never
// authorizes guests, so that class is never loaded here. If this server ever needs to talk to a
// UniFi controller, align the versions first rather than finding out through a NoSuchMethodError.
// ─────────────────────────────────────────────────────────────────────────────

object mcp extends BaseModule:
  // Pinned to whatever zio-http-mcp was built with, and nothing else: 0.10.0 ships TASTy 28.10,
  // which a 3.9 compiler refuses outright ("expected stable TASTy from 28.0 to 28.9"). It was 3.9.0
  // for 0.8.3 and 3.8.4 before that, for the same reason each time.
  //
  // Forward compatibility is the direction TASTy does not have, so this follows the dependency
  // upward and `core`, `platform` and the rest stay on 3.8.0 — backward compatibility covers reading
  // them from here. Which is also why it is only this module: 3.10 breaks Quill, and `api` writes
  // far more SQL than the backoffice does.
  //
  // What 3.10 breaks is every `update(_.column -> lift(value))`, because `->` became an inline
  // extension method and Quill's parser matches the `ArrowAssoc.->` call that no longer appears in
  // the tree. Quill 4.8.6 is the last release and predates 3.10, so that is permanent; the module
  // compiles because [[whitelabel.captal.mcp.QuillArrow]] puts the call back. Read it before
  // touching a Quill assignment here, and expect the same failure in any module moved to 3.10.
  def scalaVersion = "3.10.0"
  // Its own, because scalafix refuses `removeUnused` on 3.10 — the file says why. `mcp.test` sets
  // it again rather than inheriting: `ScalaTests` picks up `scalaVersion` from here but is its own
  // `ScalafixModule`, so it reads the root config unless told otherwise.
  def scalafixConfig = Task(Some(moduleDir / ".scalafix.conf"))

  /** Explicit because this module has two `ZIOAppDefault`s and Mill will not choose between them:
    * `Main` serves, `McpMigrate` migrates and then exits. Without it the assembly carries no
    * `Main-Class`, and the only sign is `java -jar` answering "no main manifest attribute" from
    * inside a container that has already run its migrations successfully.
    */
  def mainClass = Some("whitelabel.captal.mcp.Main")

  /** Declaring a main class makes Mill prepend a launcher script so the jar is executable on its
    * own, and that is refused above 65 535 ZIP entries — this assembly is well past it. Dropping
    * the prefix keeps the `Main-Class` in the manifest, which is the half that matters: the image
    * runs `java -jar`, never the jar directly.
    */
  def prependShellScript = ""
  def moduleDeps = Seq(core, platform)
  // The AWS SDK ships `netty-nio-client` for its *async* clients, and that client pins netty
  // 4.1.x. zio-http is on 4.2.x, where `DefaultHeaders` moved to `netty-codec-base` — so the
  // stale `netty-codec` 4.1 jar shadows the class and every request dies with
  // `NoSuchMethodError: DefaultHeaders.containsAny`. This module only builds the synchronous
  // `S3Client`/`CloudFrontClient`/`S3Presigner`, which use `apache-client`, so the async client
  // is dead weight. Excluding it is what keeps the server able to answer at all.
  def mvnDeps = Seq(
    // 0.8.3 brought MCP Apps: `ResourceContents` gained the `_meta` the Apps contract puts the CSP
    // in, without which the upload page's PUT dies as `blocked:csp`, plus `McpApps` to replace the
    // `_meta` decorator this repo hand-rolled.
    //
    // 0.10.0 for `TaskExecution`, which is what makes a long call safe: the tool declares its own
    // policy and the *server* decides, rather than the client opting in per request. `Required`
    // answers `-32021` to a client that cannot poll, instead of running synchronously and being
    // cut off by a transport timeout. 0.8.3 had the task machinery and no way to ask for it.
    //
    // It also lands `skills/list` / `skills/get` as a primitive. `read_skill` stays regardless:
    // the resources story already showed that a primitive existing is not the same as a host
    // handing it to the model.
    mvn"com.jamesward::zio-http-mcp:0.10.0",
    // Named explicitly only to force 3.0.10 over the 3.0.9 the tree resolves to. Scala 3.10's own
    // notes list it among the libraries to upgrade *before* the compiler, and it is the one on that
    // list whose breakage would be invisible here: izumi-reflect is where `Tag` comes from, so a
    // mismatch surfaces as a ZLayer that cannot find a service at runtime, not as a compile error.
    // The rest of that list is either already current — zio 2.1.26, which 0.10.0 pulls in on its
    // own — or absent from this classpath (zio-blocks, neotype).
    mvn"dev.zio::izumi-reflect:3.0.10",
    mvn"software.amazon.awssdk:s3:2.29.51".exclude("software.amazon.awssdk" -> "netty-nio-client"),
    mvn"software.amazon.awssdk:cloudfront:2.29.51".exclude(
      "software.amazon.awssdk" -> "netty-nio-client"),
    // What standing up a location's portal takes: the service, the target group and its listener
    // rule, and the log group the task writes to. `netty-nio-client` excluded as above — these are
    // all synchronous calls, and the async client would pull in a second HTTP stack beside
    // zio-http's.
    mvn"software.amazon.awssdk:ecs:2.29.51".exclude("software.amazon.awssdk" -> "netty-nio-client"),
    mvn"software.amazon.awssdk:elasticloadbalancingv2:2.29.51".exclude(
      "software.amazon.awssdk" -> "netty-nio-client"),
    mvn"software.amazon.awssdk:cloudwatchlogs:2.29.51".exclude(
      "software.amazon.awssdk" -> "netty-nio-client"),
    mvn"com.lihaoyi::scalatags:0.13.1",
    mvn"org.slf4j:slf4j-nop:1.7.36"
  )

  /** Where the skills live, for the index below to enumerate.
    *
    * `mcp/resources/skills/`, so `super.resources()` puts them on the classpath at the
    * `/skills/<slug>/SKILL.md` that `Skills.load` reads — no copy in the task at all.
    *
    * They were under `cli/resources/templates/`, because the CLI scaffolded them into the
    * operator's workspace, and this module reached across with `os.up` to borrow them. That made
    * deleting the CLI break `read_skill` silently: the server compiles fine and answers every
    * `read_skill` call with "no such skill". This server is the only thing that serves them now.
    */
  def skillSources: T[PathRef] = Task.Source(moduleDir / "resources" / "skills")

  /** The portal's own stylesheet, carried so `get_css_schema` derives the variable list from the
    * file the portal actually reads. A list kept by hand drifts, and the drift is silent: an
    * operator themes a variable nothing honours any more and sees no change.
    */
  def defaultStyles: T[PathRef] = Task.Source(
    moduleDir / os.up / "client" / "assets" / "styles.css")

  def resources: T[Seq[PathRef]] = Task:
    // Only the index is generated. The skills themselves are already on the classpath through
    // `super.resources()`, and `/skills/index.txt` merges into the same logical directory from
    // here — which is the whole reason this is a list of PathRefs.
    //
    // Generated rather than written by hand because `read_skill` advertises the catalogue in its
    // description: an index that disagrees with the directory is a skill the model is told to read
    // and cannot, or one that exists and is never mentioned.
    val dest = Task.dest / "skills"
    os.makeDir.all(dest)
    val names = os.list(skillSources().path).filter(os.isDir).map(_.last).sorted
    os.write(dest / "index.txt", names.mkString("\n"))
    os.copy(defaultStyles().path, Task.dest / "default-styles.css")
    // The MCP Apps' code is no longer carried here. It used to be: the page inlined it, because a
    // `<script src>` looked impossible under the iframe's CSP. It is not — `resourceDomains` maps
    // to `script-src` among others — so the scripts are published to the CDN by `client.publish`
    // and the page names them by a stable URL. The server does not hold them and does not know
    // their content, which is the same reason the content itself stopped travelling in the deploy
    // artifact.
    super.resources() ++ Seq(PathRef(Task.dest))

  private val localStackPort = 4566
  private val devPort = 8081

  def localStackSetup() = Task.Command:
    ensureLocalStack(localStackContainer, localStackPort, devBucket, Task.env)

  def stopLocalStack() = Task.Command:
    os.proc("docker", "rm", "-f", localStackContainer).call(check = false)
    println("localstack dev container stopped")

  /** Runs the backoffice against local rqlite and LocalStack.
    *
    * Everything the server refuses to start without is supplied here, so the failure modes it is
    * designed to have — no tokens, no bucket — do not get in the way of running it locally.
    *
    * The token is fixed and printed rather than generated: it goes into a `.mcp.json` by hand, and
    * one that changed every run would be copied wrong more often than it would be secure. It is a
    * local server holding local data.
    *
    * Usage: ./mill mcp.dev
    */
  def dev(port: Int = devPort, token: String = "dev-token") = Task.Command:
    val migrationCp = platform.runClasspath().map(_.path.toString).mkString(java.io.File.pathSeparator)
    val cp = runClasspath().map(_.path.toString).mkString(java.io.File.pathSeparator)

    println("[dev] Step 1/4: Ensuring rqlite...")
    val dbUrl = ensureRqlite(rqliteDevContainerName, rqliteDevPort)

    println("[dev] Step 2/4: Running migrations...")
    val migration = os
      .proc("java", "-cp", migrationCp, "whitelabel.captal.platform.Migrate")
      .call(env = Map("DB_URL" -> dbUrl), check = false, stdout = os.Inherit, stderr = os.Inherit)
    if migration.exitCode != 0 then
      sys.error("[dev] Migrations failed; the server would start against a schema-less database.")

    println("[dev] Step 3/4: Ensuring LocalStack...")
    val endpoint = ensureLocalStack(localStackContainer, localStackPort, devBucket, Task.env)

    println(s"[dev] Step 4/4: Starting MCP backoffice on :$port")

    val env =
      forkEnv() ++
        Map(
          "DB_URL"           -> dbUrl,
          "MCP_PORT"         -> port.toString,
          "MCP_RESOURCE_URI" -> s"http://localhost:$port/mcp",
          // Seeds the admin row, which holds every scope. Other tokens are issued from it with
          // `create_token`; a local run only ever needs the one.
          "MCP_ADMIN_TOKEN" -> token,
          "ASSETS_BUCKET"   -> devBucket,
          // A real distribution over the dev bucket, created once. It was a made-up id while every
          // invalidation against a local endpoint was skipped; now that the skip is gone, an asset
          // write in this flow really does invalidate, and a fictional id would fail the write's
          // last step with the object already stored.
          "CLOUDFRONT_DISTRIBUTION_ID" -> ensureDistribution(
            localStackContainer,
            "captal-mcp-dev",
            devBucket),
          // Where the portal fetches an asset from, which is what gets stored as a video's
          // `video_url`. In production this is the CloudFront distribution; locally it is the
          // bucket on LocalStack, path-style.
          //
          // It used to be this server's own address, which is a thing no asset is ever served
          // from: every video created locally was stored with a URL that answers nothing, and the
          // player would fail on a row that looked perfectly well-formed. The MCP port and the
          // asset origin have nothing to do with each other.
          "PUBLIC_BASE_URL"  -> s"$endpoint/$devBucket",
          "AWS_ENDPOINT_URL" -> endpoint,
          "AWS_REGION"       -> "us-east-1",
          // LocalStack does not verify signatures; the signer only needs a pair to exist.
          "AWS_ACCESS_KEY_ID"     -> "test",
          "AWS_SECRET_ACCESS_KEY" -> "test"
        )

    // Every tool here is scoped to a location, and none of them can create one — locations still
    // arrive through provisioning. `api.dev` seeds `cafe-centro` into this same container on boot,
    // which is the whole reason the two commands share it.
    val seeded =
      val probe = scala
        .util
        .Try:
          val url =
            java
              .net
              .URI
              .create(s"http://localhost:$rqliteDevPort/db/query?q=SELECT+COUNT(*)+FROM+locations")
              .toURL
          scala.io.Source.fromInputStream(url.openStream()).mkString
      if probe.toOption.exists(_.contains("[[0]]")) then
        "  No locations in the database yet — run `./mill api.dev` once to seed cafe-centro.\n"
      else
        ""

    println(s"""
      |[dev] Point a host at it with:
      |
      |  "captal": {
      |    "command": "npx",
      |    "args": ["mcp-remote", "http://localhost:$port/mcp",
      |             "--header", "Authorization: Bearer $token"]
      |  }
      |
      |$seeded""".stripMargin)

    os.proc("java", forkArgs(), "-cp", cp, "whitelabel.captal.mcp.Main")
      .call(env = env, stdin = os.Inherit, stdout = os.Inherit, stderr = os.Inherit)

  def dockerfile: T[PathRef] = Task.Source(moduleDir / os.up / "Dockerfile.mcp")

  /** Build the server's image. Usage: `./mill mcp.image` or `./mill mcp.image --tag v1.2.3`
    *
    * The jar is built here, by the tool that already knows how, and the image only packages it.
    * `Dockerfile.api` does the opposite — it copies the sources in and runs `./mill api.assembly`
    * inside the builder stage — and that has rotted twice over: it copies `provision/`, which was
    * deleted with the provisioning system, and a `mill` wrapper script that is not in this
    * repository. Compiling inside the image also re-resolves the whole dependency tree on every
    * build, for no gain over a jar Mill has already produced and cached.
    *
    * The context is a staged directory holding exactly two files, which is also why the Dockerfile
    * can say `COPY mcp.jar`: reaching into `out/mcp/assembly.dest/` from a Dockerfile would make
    * the build context the entire repository and would break the first time Mill's output layout
    * moved.
    */
  def image(tag: String = "latest") = Task.Command:
    val context = Task.dest / "context"
    os.makeDir.all(context)
    os.copy.over(assembly().path, context / "mcp.jar")
    os.copy.over(dockerfile().path, context / "Dockerfile")

    val name = s"captal-mcp:$tag"
    val built = os
      .proc("docker", "build", "-t", name, ".")
      .call(cwd = context, check = false, stdout = os.Inherit, stderr = os.Inherit)
    if built.exitCode != 0 then
      sys.error("[image] docker build failed")
    println(s"[image] built $name")
    name

  /** Push the image into a registry, which locally means LocalStack's own ECR. Usage:
    * `./mill mcp.imagePush --registry 000000000000.dkr.ecr.us-east-1.localhost.localstack.cloud:4566 --repository captal-mcp-local`
    *
    * Separate from [[image]] because building is the common case and pushing needs a registry that
    * exists. Against LocalStack the registry is the one `tofu apply` created, which is what
    * `mcp_image_repository_url` reports.
    */
  def imagePush(registry: String, repository: String, tag: String = "latest") = Task.Command:
    val local = image(tag)()
    val remote = s"$registry/$repository:$tag"
    for args <- Seq(Seq("tag", local, remote), Seq("push", remote))
    do
      val result = os.proc("docker" +: args).call(check = false, stderr = os.Pipe)
      if result.exitCode != 0 then
        sys.error(s"[image] docker ${args.head} failed: ${result.err.trim()}")
    println(s"[image] pushed $remote")
    remote

  object test extends ScalaTests with ScalafmtModule with ScalafixModule:
    // zio-test 2.1.26 to match what zio-http-mcp pulls in; the rest of the build is on 2.1.14 and
    // stays there. Scala 3.10's own notes name 2.1.26 as the version to be on before the compiler,
    // so this module and the one it tests now agree for two independent reasons.
    def mvnDeps = Seq(
      mvn"dev.zio::zio-test:2.1.26",
      mvn"dev.zio::zio-test-sbt:2.1.26",
      // `TestClient`, which serves this server's own routes to a client with no socket between
      // them. What that buys is the half the end-to-end spec could not otherwise reach: JSON-RPC
      // dispatch, the auth middleware, and decoding from raw JSON rather than from a codec round
      // trip. Matched to the zio-http that zio-http-mcp pulls in — a testkit from a different
      // minor would be a second `Client` trait.
      mvn"dev.zio::zio-http-testkit:3.11.6"
    )
    def testFramework = "zio.test.sbt.ZTestFramework"
    // The same exception the module itself takes; see `mcp.scalafixConfig`.
    def scalafixConfig = mcp.scalafixConfig

    /** The published bundle, carried as a *test* resource.
      *
      * `UploadUiSpec` used to assert the protocol strings — `ui/initialize`, `tools/call`,
      * `ui/message` — against the page, because the page inlined the script. It does not any more,
      * and those assertions are still worth having: none of those strings fails loudly, a bad
      * envelope is ignored by the host in silence and a missing `ui/message` leaves the agent
      * waiting on a confirmation that already happened.
      *
      * So they moved to the artifact that actually ships. Here and not in `mcp.resources`, because
      * the whole point of the move was that the server stops carrying this file — a production jar
      * holding a copy would put the two back out of step.
      */
    override def resources: T[Seq[PathRef]] = Task:
      val dest = Task.dest / "ui"
      os.makeDir.all(dest)
      for
        file <- os.list(client.bundle().path)
        if file.ext == "js"
      do
        os.copy(file, dest / file.last)
      super.resources() ++ Seq(PathRef(Task.dest))

    // Its own container, not the one api.test uses: the two suites share a schema and would clear
    // each other's rows.
    private val rqlitePort = 4012
    private val rqliteContainer = "rqlite-mcp-test"

    // The end-to-end spec's own, for the reason given at `migratedE2eUrl`.
    private val e2ePort = 4013
    private val e2eContainer = "rqlite-mcp-e2e"

    /** The container's id and URL, as one input.
      *
      * `Task.Input` so every run re-checks the container is actually alive, rather than caching a
      * URL that points at something the operator removed in between.
      *
      * The id is in here because the URL alone is not enough to invalidate [[migratedRqliteUrl]]:
      * it is the same string for a container that was removed and recreated, so a plain `Task`
      * downstream would reuse its cached result and skip the migration. The id is what actually
      * changes, and a `docker rm` followed by a run that touched no source has to re-migrate — or
      * the suite tests against an empty database and fails in a way that looks like the schema
      * rather than the cache.
      */
    private def rqliteStamp: T[String] = Task.Input:
      val url = ensureRqlite(rqliteContainer, rqlitePort)
      val id = os.proc("docker", "ps", "-q", "-f", s"name=$rqliteContainer").call().out.trim()
      s"$id $url"

    def rqliteUrl: T[String] = Task:
      rqliteStamp().split(" ").last

    /** The same URL, with the schema already laid down.
      *
      * Migrating here rather than in each spec, because Flyway cannot migrate concurrently on
      * SQLite and logs that it is not even trying: "Unable to lock flyway_schema_history as SQLite
      * does not support locking. No concurrent migration supported." Mill forks a JVM per spec, so
      * five specs each ran their own Flyway against one rqlite at once.
      *
      * That was survivable while every migration only added things — the race produced "already
      * exists" warnings and nothing else. V22 rebuilds `advertiser_videos` (SQLite cannot alter a
      * CHECK), so the race became destructive: one runner dropped the table while another had
      * already renamed its replacement over it, and the suite deleted its own schema. The symptom
      * is "No result set returned" from whichever spec reads that table next, which names neither
      * the table nor the cause.
      *
      * Two processes, in order, because the second checks the first has run: the API owns every
      * table the portal reads, and the backoffice owns only its tokens.
      *
      * Through `Migrate` and `McpMigrate` rather than a Flyway assembled here, which is not a
      * matter of taste. rqlite reports a rejected statement inside an HTTP 200 and the driver turns
      * that into zero rows, so DDL run without `Migrate`'s DataSource wrapper does nothing and
      * Flyway records it as applied. The four specs that assembled their own also set
      * `cleanOnValidationError`, which drops every table — so a history those silent no-ops had
      * corrupted would wipe the database on the next run and call it recovery.
      */
    def migratedRqliteUrl: T[String] = Task:
      // The stamp, not `rqliteUrl`, so a recreated container invalidates this.
      migrateSchema(rqliteStamp().split(" ").last, platform.runClasspath(), runClasspath())

    /** Both schemas against one URL, in order, as two processes.
      *
      * In order because the second checks the first has run: the API owns every table the portal
      * reads, and the backoffice owns only its tokens.
      *
      * Through `Migrate` and `McpMigrate` rather than a Flyway assembled here, which is not a
      * matter of taste. rqlite reports a rejected statement inside an HTTP 200 and the driver turns
      * that into zero rows, so DDL run without `Migrate`'s DataSource wrapper does nothing and
      * Flyway records it as applied.
      */
    private def migrateSchema(
        url: String,
        apiClassPath: Seq[PathRef],
        mcpClassPath: Seq[PathRef]): String =
      val env = Map("DB_URL" -> url)
      def migrate(label: String, classPath: Seq[PathRef], mainClass: String): Unit =
        println(s"[migrate] $label ($url) ...")
        val result = os
          .proc("java", "-cp", classPath.map(_.path).mkString(":"), mainClass)
          .call(env = env, check = false, stderr = os.Pipe, stdout = os.Pipe)
        if result.exitCode != 0 then
          sys.error(s"[migrate] $label failed:\n${result.err.text().trim}")
      migrate("api schema", apiClassPath, "whitelabel.captal.platform.Migrate")
      migrate("backoffice schema", mcpClassPath, "whitelabel.captal.mcp.McpMigrate")
      url

    /** A database of its own for the end-to-end spec, for the reason this module already has one of
      * its own rather than sharing `api.test`'s: suites that share a schema clear each other's rows.
      *
      * One level down, the same thing was happening inside this module. Advertisers and the three
      * identification surveys are deployment-wide rather than scoped to a location, so on a shared
      * database `get_location_readiness` counts what every other spec wrote — and the end-to-end
      * run watched `SurveyToolsSpec` delete, between two of its own calls, the survey it had just
      * read. Isolation is what lets that spec assert on exactly what it created.
      */
    private def e2eStamp: T[String] = Task.Input:
      val url = ensureRqlite(e2eContainer, e2ePort)
      val id = os.proc("docker", "ps", "-q", "-f", s"name=$e2eContainer").call().out.trim()
      s"$id $url"

    def migratedE2eUrl: T[String] = Task:
      migrateSchema(e2eStamp().split(" ").last, platform.runClasspath(), runClasspath())

    /** LocalStack's container, its endpoint, and whether a licence was configured — as one input.
      *
      * The same shape as [[rqliteStamp]] and for the same reason, plus one more: the licence belongs
      * in the cache key. `Task.env` read inside a cached task would be the environment of whichever
      * invocation happened to populate the cache, so configuring a token and re-running would reuse
      * an empty fixture and the end-to-end test would skip itself with no explanation.
      */
    private def localStackStamp: T[String] = Task.Input:
      val licensed = localStackToken(Task.env).isDefined
      val endpoint = ensureLocalStack(localStackContainer, localStackPort, devBucket, Task.env)
      val id = os.proc("docker", "ps", "-q", "-f", s"name=$localStackContainer").call().out.trim()
      s"$id $endpoint $licensed"

    /** The configuration's files, declared so that Mill permits reading them.
      *
      * Not needed while it was a sibling repository: Mill polices reads inside the build's own tree
      * and that was outside it. Moving it to `terraform/` put it under the rule, and the apply
      * failed on the copy with a message that names the task rather than the read —
      * `Reading from terraform not allowed during execution of mcp.test.localStackInfra`.
      *
      * The literal path rather than `terraformDir`, because `Task.Sources` cannot read `Task.env`
      * to honour `CAPTAL_TERRAFORM_DIR`. That costs nothing: an override points somewhere outside
      * this tree, which is the case Mill does not police anyway.
      */
    def tofuSources: T[Seq[PathRef]] = Task.Sources(moduleDir / os.up / os.up / "terraform")

    /** The OpenTofu configuration's content, tracked so that editing it re-applies.
      *
      * Still a `Task.Input` and not derived from [[tofuSources]], because the hash has to cover
      * whichever directory `terraformDir` resolves to, override included.
      */
    private def tofuConfig: T[Int] = Task.Input:
      val dir = terraformDir(Task.env, moduleDir / os.up / os.up)
      if !os.exists(dir) then
        0
      else
        os.walk(dir)
          .filter(p => os.isFile(p) && (p.last.endsWith(".tf") || p.last.endsWith(".tfvars")))
          .sorted
          .map(p => (p.relativeTo(dir).toString, os.read(p)).hashCode)
          .sum

    /** The cluster, network and load balancer a deploy attaches to, as the environment that names
      * them. Empty without a licence; see [[ensureLocalStackTofu]].
      *
      * `persistent = true` is what makes the state and the container stay paired, and it is the
      * whole reason this is not a plain `Task`. A normal task's `dest` is wiped on every
      * re-evaluation, so editing the configuration would discard the state while LocalStack still
      * held all seventy resources — and the next apply would plan a create for each of them and
      * fail with `AlreadyExists`. Persistent keeps the state across re-evaluations, and the
      * container id in the path keeps it honest: a recreated container is a new id, so it gets an
      * empty directory and the two are built together.
      */
    def localStackInfra: T[Map[String, String]] = Task(persistent = true):
      val parts = localStackStamp().split(" ")
      // Read for the dependency, not the value: the hash is what makes a changed `.tf` re-apply,
      // and the sources are what let this task read them at all.
      tofuConfig()
      tofuSources()
      ensureLocalStackTofu(
        endpoint = parts(1),
        licensed = parts(2).toBoolean,
        configDir = terraformDir(Task.env, moduleDir / os.up / os.up),
        stateDir = Task.dest / parts(0))

    /** Recreates LocalStack, which is what clears a state that has come apart from it.
      *
      * `-v` and not just `-f`: LocalStack keeps its data in an anonymous volume at
      * `/var/lib/localstack`, which `docker rm -f` leaves behind — the container would come back
      * carrying every resource the last one had, which is the divergence this exists to clear.
      *
      * The state is not deleted here and does not need to be: it is keyed by container id, so the
      * replacement container reaches a directory that has never existed. The dev buckets do go.
      * They are emulated and the build recreates them, but a bundle published locally is gone.
      */
    def resetLocalStack() = Task.Command:
      os.proc("docker", "rm", "-fv", localStackContainer).call(check = false)
      println(
        s"[tofu] LocalStack removed with its volume; the next run builds the container and its state together")

    /** The unlicensed fallback for `ASSETS_BUCKET`, which [[localStackInfra]] overrides with the
      * bucket the configuration creates whenever there is a licence to create it.
      *
      * Still not the one `mcp.dev` serves, which is why it exists: the end-to-end spec publishes a
      * bundle and clears the prefix first to make its own fixture deterministic — it had been
      * counting an object a previous version of itself left behind. On the dev bucket that clearing
      * would delete a developer's assets, which is not a thing a test gets to do. The
      * configuration's own bucket is a different name again, so the override keeps that property.
      */
    def testBucket: T[String] = Task:
      val name = "captal-assets-mcp-test"
      // The stamp, so a recreated container gets the bucket again.
      localStackStamp()
      os.proc(
        "docker",
        "exec",
        localStackContainer,
        "awslocal",
        "s3api",
        "create-bucket",
        "--bucket",
        name)
        .call(check = false, stderr = os.Pipe)
      name

    /** What the server reads at startup, so a test exercises the real layers.
      *
      * `RqliteDataSource` reads `database.jdbcUrl`, which platform's application.conf overrides from
      * `DB_URL`. The asset variables are here rather than in each spec because `AssetStore.layer`
      * requires all three, and the end-to-end test builds the whole server rather than a store.
      *
      * The database is created and migrated outside the deploy on purpose: it is not something a
      * location provisions, and `DB_URL` is a value the server knows in advance and injects into
      * every task definition it registers.
      */
    override def forkEnv: T[Map[String, String]] = Task:
      super.forkEnv() ++
        Map(
          "DB_URL"                     -> migratedRqliteUrl(),
          // The end-to-end spec builds its own data source from this rather than reading `DB_URL`,
          // which every other spec resolves through `application.conf`.
          "E2E_DB_URL"                 -> migratedE2eUrl(),
          "ASSETS_BUCKET"              -> testBucket(),
          // No `CLOUDFRONT_DISTRIBUTION_ID` here: `localStackInfra` supplies the real one it
          // created. It used to be a made-up value, needed only because `AssetStore.layer` requires
          // the name and safe only because a flag kept the client from ever being called.
          "PUBLIC_BASE_URL"            -> "https://portal.test"
        ) ++ localStackInfra()

    def stopRqlite() = Task.Command:
      os.proc("docker", "rm", "-f", rqliteContainer).call(check = false)
      println("rqlite mcp test container stopped")
  end test
end mcp

// La página de pausa era `object maintenance`, con su propio linker run y por lo tanto con el
// Closure Compiler. Ahora es el cuarto módulo público de `client`; su template vive en
// `client/maintenance.html.template` y su stub en `client/entries/maintenance.js`.

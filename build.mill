//| mvnDeps:
//|   - com.goyeau::mill-scalafix::0.6.0
//|   - com.lihaoyi::mill-contrib-scalapblib:$MILL_VERSION
package build
import com.goyeau.mill.scalafix.ScalafixModule
import mill.*, scalalib.*, scalafmt.*, scalajslib.*
import millbuild.*

// ─────────────────────────────────────────────────────────────────────────────
// rqlite image
// ─────────────────────────────────────────────────────────────────────────────

/** The database image the ECS cluster runs: `docker/rqlite.Dockerfile`, the engine at [[rqliteVersion]]
  * plus this repository's entrypoint. Pushed under the tag each environment's `terraform.tfvars` names.
  */
object rqlite extends Module:

  /** The two files the image is built from. Declared as sources, so that a change to either rebuilds it.
    */
  def dockerSources: T[Seq[PathRef]] = Task.Sources(
    moduleDir / os.up / "docker" / "rqlite.Dockerfile",
    moduleDir / os.up / "docker" / "rqlite-entrypoint.sh")

  /** Builds `captal-rqlite:<tag>`. Usage: `mill rqlite.image --tag 1.0.5` */
  def image(tag: String = "latest") = Task.Command:
    val sources = dockerSources()
    val missing = sources.filterNot(ref => os.exists(ref.path))
    if missing.nonEmpty then
      sys.error(s"[rqlite] missing from docker/: ${missing.map(_.path.last).mkString(", ")}")
    val context = sources.head.path / os.up
    val name = s"captal-rqlite:$tag"
    val built = os
      // `-f`: the context directory holds every image's Dockerfile.
      .proc("docker", "build", "-f", "rqlite.Dockerfile", "-t", name, ".")
      .call(cwd = context, check = false, stdout = os.Inherit, stderr = os.Inherit)
    if built.exitCode != 0 then
      sys.error("[rqlite] docker build failed")
    println(s"[rqlite] built $name")
    name

  /** Pushes it into a registry. Usage:
    * `mill rqlite.imagePush --registry 000000000000.dkr.ecr.us-east-1.amazonaws.com --repository captal-rqlite --tag 1.0.4`
    */
  def imagePush(registry: String, repository: String, tag: String = "latest") = Task.Command:
    val local = image(tag)()
    pushImage(local, s"$registry/$repository:$tag")

object `core-js` extends BaseJSModule with CoreDepsJS:
  def sources = build.core.sources

object `messages-js` extends BaseJSModule:
  def moduleDeps = Seq(`core-js`)
  def sources = build.messages.sources
  def scalacOptions = super.scalacOptions() ++ Seq("-Xmax-inlines:64")
  def mvnDeps = Seq(
    mvn"io.circe::circe-core::0.14.10",
    mvn"io.circe::circe-generic::0.14.10",
    mvn"io.circe::circe-parser::0.14.10")

// ─────────────────────────────────────────────────────────────────────────────
// CI: the release CodeBuild runs
// ─────────────────────────────────────────────────────────────────────────────

object ci extends Module:

  /** Releases this build to the environment named by `CAPTAL_ENV`, in five steps: builds the rqlite,
    * API and backoffice images; applies the configuration with their versions; moves every deployed
    * location onto the API image and waits for them to settle; publishes the client and invalidates;
    * tags the commit with each version that moved. Versions come from [[Released]].
    *
    * A module whose version did not move is not republished; the configuration is applied every time.
    * Credentials come from the CodeBuild role (see [[ReleaseTarget]]). Needs Docker (privileged), `tofu`,
    * `git-cliff`, the `aws` CLI, a clone with its tags, and permission to push tags.
    *
    * With `AWS_ENDPOINT_URL` set to this build's LocalStack it releases there and tags nothing, which is
    * how it runs on a dev machine: `CAPTAL_ENV=local AWS_ENDPOINT_URL=http://localhost:4567 mill ci.run`.
    * `mcp.dev` runs the first four steps without waiting for the locations to settle.
    *
    * Usage: `mill ci.run`
    */
  def run() = Task.Command:
    val target = ReleaseTarget.fromEnv(Task.env)
    val workDir =
      if target.local then
        localStackWorkDir(target, Task.env)
      else
        Task.dest
    val workspace = moduleDir / os.up
    val configDir = terraformDir(Task.env, workspace)
    val versions =
      Seq(build.api.releaseVersion(), build.mcp.releaseVersion(), build.client.releaseVersion())
    val tags = ImageTags(api = versions(0).version, mcp = versions(1).version)
    val clientVersion = versions(2).version
    val built = BuiltImages(
      rqlite = Some(rqlite.image()()),
      api = Some(build.api.image()()),
      mcp = Some(build.mcp.image()()))
    val bundle = build.client.bundle().path

    versions.foreach: release =>
      println(s"[ci] ${release.previousTag match
          case None                               => s"${release.tag}, the first release"
          case Some(previous) if release.changed => s"$previous -> ${release.tag}"
          case Some(previous)                     => s"$previous, which nothing since moves"
        }")
    println(s"[ci] Steps 1-2/5: Images built; applying the ${target.environment} configuration...")
    val (outputs, published) = applyConfiguration(target, configDir, workDir, tags): registries =>
      publishImages(target, configDir, registries, built, tags)
    val apiImage = published.getOrElse(sys.error("[ci] the API image was not published"))
    def output(name: String) = outputs.getOrElse(
      name,
      sys.error(s"[ci] the configuration has no $name output"))
    val cluster = output("ecs_cluster_name")

    println("[ci] Step 3/5: Moving every location onto the API image...")
    val locations = locationServices(target, cluster)
    rollLocations(target, cluster, locations, apiImage, await = true)

    // Published once per version: skipped when the bucket holds it already. Locally it is always published.
    val bucket = output("assets_bucket_name")
    if !target.local && clientPublished(target, bucket, clientVersion) then
      println(s"[ci] Step 4/5: The client's $clientVersion is published already")
    else
      println(s"[ci] Step 4/5: Publishing the client's $clientVersion to every location...")
      publishClient(
        target,
        bundle,
        clientVersion,
        bucket,
        output("cloudfront_distribution_id"),
        locations)

    val moved = versions.filter(_.changed).map(_.tag)
    if moved.isEmpty then
      println("[ci] Step 5/5: No version moved, so there is nothing to tag")
    else if target.local then
      println(
        s"[ci] Step 5/5: Not tagging ${moved.mkString(", ")}: a release to LocalStack is not a release")
    else
      println(s"[ci] Step 5/5: Tagging ${moved.mkString(", ")}...")
      def git(args: String*): Unit =
        val result = os.proc("git", args).call(cwd = workspace, check = false, stderr = os.Pipe)
        if result.exitCode != 0 then
          sys.error(s"[ci] git ${args.head} failed: ${result.err.trim()}")
      moved.foreach: tag =>
        git("tag", tag)
        git("push", "origin", s"refs/tags/$tag")

  /** For a release to LocalStack: starts this build's container if needed and returns the state
    * directory that `mcp.dev` shares.
    */
  private def localStackWorkDir(target: ReleaseTarget, env: Map[String, String]): os.Path =
    val port = java.net.URI(target.endpoint.get).getPort
    if port != localStackPort then
      sys.error(
        s"[ci] AWS_ENDPOINT_URL names port $port, and this build's LocalStack listens on $localStackPort")
    if localStackToken(env).isEmpty then
      sys.error(
        "[ci] the release needs ECS, which LocalStack runs only with a licence. Set LOCALSTACK_AUTH_TOKEN in .env.")
    ensureLocalStack(localStackContainer, localStackPort, env)
    localStackStateDir(localStackContainerId().getOrElse(
      sys.error(s"[ci] '$localStackContainer' is not running after starting it; `docker logs $localStackContainer` says why")))
end ci

